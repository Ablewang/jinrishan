{"id":44,"title":"寻隐者不遇","dynasty":"唐","author":"贾岛","lines":[{"text":"松下问童子，","pinyin":"sōng xià wèn tóng zǐ","chars":[{"char":"松","pinyin":"sōng"},{"char":"下","pinyin":"xià"},{"char":"问","pinyin":"wèn"},{"char":"童","pinyin":"tóng"},{"char":"子","pinyin":"zǐ"},{"char":"，","pinyin":null}]},{"text":"言师采药去。","pinyin":"yán shī cǎi yào qù","chars":[{"char":"言","pinyin":"yán"},{"char":"师","pinyin":"shī"},{"char":"采","pinyin":"cǎi"},{"char":"药","pinyin":"yào"},{"char":"去","pinyin":"qù"},{"char":"。","pinyin":null}]},{"text":"只在此山中，","pinyin":"zhǐ zài cǐ shān zhōng","chars":[{"char":"只","pinyin":"zhǐ"},{"char":"在","pinyin":"zài"},{"char":"此","pinyin":"cǐ"},{"char":"山","pinyin":"shān"},{"char":"中","pinyin":"zhōng"},{"char":"，","pinyin":null}]},{"text":"云深不知处。","pinyin":"yún shēn bù zhī chù","chars":[{"char":"云","pinyin":"yún"},{"char":"深","pinyin":"shēn"},{"char":"不","pinyin":"bù"},{"char":"知","pinyin":"zhī"},{"char":"处","pinyin":"chù"},{"char":"。","pinyin":null}]}],"titlePinyin":["xún","yǐn","zhě","bú","yù"]}