{"id":62,"title":"四时田园杂兴（其二十五）","dynasty":"宋","author":"范成大","lines":[{"text":"梅子金黄杏子肥，","pinyin":"méi zǐ jīn huáng xìng zǐ féi","chars":[{"char":"梅","pinyin":"méi"},{"char":"子","pinyin":"zǐ"},{"char":"金","pinyin":"jīn"},{"char":"黄","pinyin":"huáng"},{"char":"杏","pinyin":"xìng"},{"char":"子","pinyin":"zǐ"},{"char":"肥","pinyin":"féi"},{"char":"，","pinyin":null}]},{"text":"麦花雪白菜花稀。","pinyin":"mài huā xuě bái cài huā xī","chars":[{"char":"麦","pinyin":"mài"},{"char":"花","pinyin":"huā"},{"char":"雪","pinyin":"xuě"},{"char":"白","pinyin":"bái"},{"char":"菜","pinyin":"cài"},{"char":"花","pinyin":"huā"},{"char":"稀","pinyin":"xī"},{"char":"。","pinyin":null}]},{"text":"日长篱落无人过，","pinyin":"rì cháng lí luò wú rén guò","chars":[{"char":"日","pinyin":"rì"},{"char":"长","pinyin":"cháng"},{"char":"篱","pinyin":"lí"},{"char":"落","pinyin":"luò"},{"char":"无","pinyin":"wú"},{"char":"人","pinyin":"rén"},{"char":"过","pinyin":"guò"},{"char":"，","pinyin":null}]},{"text":"惟有蜻蜓蛱蝶飞。","pinyin":"wéi yǒu qīng tíng jiá dié fēi","chars":[{"char":"惟","pinyin":"wéi"},{"char":"有","pinyin":"yǒu"},{"char":"蜻","pinyin":"qīng"},{"char":"蜓","pinyin":"tíng"},{"char":"蛱","pinyin":"jiá"},{"char":"蝶","pinyin":"dié"},{"char":"飞","pinyin":"fēi"},{"char":"。","pinyin":null}]}],"titlePinyin":["sì","shí","tián","yuán","zá","xīng","（","qí","èr","shí","wǔ","）"]}