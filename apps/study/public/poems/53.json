{"id":53,"title":"书湖阴先生壁","dynasty":"宋","author":"王安石","lines":[{"text":"茅檐长扫净无苔，","pinyin":"máo yán cháng sǎo jìng wú tái","chars":[{"char":"茅","pinyin":"máo"},{"char":"檐","pinyin":"yán"},{"char":"长","pinyin":"cháng"},{"char":"扫","pinyin":"sǎo"},{"char":"净","pinyin":"jìng"},{"char":"无","pinyin":"wú"},{"char":"苔","pinyin":"tái"},{"char":"，","pinyin":null}]},{"text":"花木成畦手自栽。","pinyin":"huā mù chéng qí shǒu zì zāi","chars":[{"char":"花","pinyin":"huā"},{"char":"木","pinyin":"mù"},{"char":"成","pinyin":"chéng"},{"char":"畦","pinyin":"qí"},{"char":"手","pinyin":"shǒu"},{"char":"自","pinyin":"zì"},{"char":"栽","pinyin":"zāi"},{"char":"。","pinyin":null}]},{"text":"一水护田将绿绕，","pinyin":"yì shuǐ hù tián jiāng lǜ rào","chars":[{"char":"一","pinyin":"yì"},{"char":"水","pinyin":"shuǐ"},{"char":"护","pinyin":"hù"},{"char":"田","pinyin":"tián"},{"char":"将","pinyin":"jiāng"},{"char":"绿","pinyin":"lǜ"},{"char":"绕","pinyin":"rào"},{"char":"，","pinyin":null}]},{"text":"两山排闼送青来。","pinyin":"liǎng shān pái tà sòng qīng lái","chars":[{"char":"两","pinyin":"liǎng"},{"char":"山","pinyin":"shān"},{"char":"排","pinyin":"pái"},{"char":"闼","pinyin":"tà"},{"char":"送","pinyin":"sòng"},{"char":"青","pinyin":"qīng"},{"char":"来","pinyin":"lái"},{"char":"。","pinyin":null}]}],"titlePinyin":["shū","hú","yīn","xiān","shēng","bì"]}