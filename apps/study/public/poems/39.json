{"id":39,"title":"池上","dynasty":"唐","author":"白居易","lines":[{"text":"小娃撑小艇，","pinyin":"xiǎo wá chēng xiǎo tǐng","chars":[{"char":"小","pinyin":"xiǎo"},{"char":"娃","pinyin":"wá"},{"char":"撑","pinyin":"chēng"},{"char":"小","pinyin":"xiǎo"},{"char":"艇","pinyin":"tǐng"},{"char":"，","pinyin":null}]},{"text":"偷采白莲回。","pinyin":"tōu cǎi bái lián huí","chars":[{"char":"偷","pinyin":"tōu"},{"char":"采","pinyin":"cǎi"},{"char":"白","pinyin":"bái"},{"char":"莲","pinyin":"lián"},{"char":"回","pinyin":"huí"},{"char":"。","pinyin":null}]},{"text":"不解藏踪迹，","pinyin":"bù jiě cáng zōng jì","chars":[{"char":"不","pinyin":"bù"},{"char":"解","pinyin":"jiě"},{"char":"藏","pinyin":"cáng"},{"char":"踪","pinyin":"zōng"},{"char":"迹","pinyin":"jì"},{"char":"，","pinyin":null}]},{"text":"浮萍一道开。","pinyin":"fú píng yí dào kāi","chars":[{"char":"浮","pinyin":"fú"},{"char":"萍","pinyin":"píng"},{"char":"一","pinyin":"yí"},{"char":"道","pinyin":"dào"},{"char":"开","pinyin":"kāi"},{"char":"。","pinyin":null}]}],"titlePinyin":["chí","shàng"]}