{"id":50,"title":"江上渔者","dynasty":"宋","author":"范仲淹","lines":[{"text":"江上往来人，","pinyin":"jiāng shàng wǎng lái rén","chars":[{"char":"江","pinyin":"jiāng"},{"char":"上","pinyin":"shàng"},{"char":"往","pinyin":"wǎng"},{"char":"来","pinyin":"lái"},{"char":"人","pinyin":"rén"},{"char":"，","pinyin":null}]},{"text":"但爱鲈鱼美。","pinyin":"dàn ài lú yú měi","chars":[{"char":"但","pinyin":"dàn"},{"char":"爱","pinyin":"ài"},{"char":"鲈","pinyin":"lú"},{"char":"鱼","pinyin":"yú"},{"char":"美","pinyin":"měi"},{"char":"。","pinyin":null}]},{"text":"君看一叶舟，","pinyin":"jūn kàn yí yè zhōu","chars":[{"char":"君","pinyin":"jūn"},{"char":"看","pinyin":"kàn"},{"char":"一","pinyin":"yí"},{"char":"叶","pinyin":"yè"},{"char":"舟","pinyin":"zhōu"},{"char":"，","pinyin":null}]},{"text":"出没风波里。","pinyin":"chū mò fēng bō lǐ","chars":[{"char":"出","pinyin":"chū"},{"char":"没","pinyin":"mò"},{"char":"风","pinyin":"fēng"},{"char":"波","pinyin":"bō"},{"char":"里","pinyin":"lǐ"},{"char":"。","pinyin":null}]}]}