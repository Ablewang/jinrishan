{"id":48,"title":"乐游原","dynasty":"唐","author":"李商隐","lines":[{"text":"向晚意不适，","pinyin":"xiàng wǎn yì bú shì","chars":[{"char":"向","pinyin":"xiàng"},{"char":"晚","pinyin":"wǎn"},{"char":"意","pinyin":"yì"},{"char":"不","pinyin":"bú"},{"char":"适","pinyin":"shì"},{"char":"，","pinyin":null}]},{"text":"驱车登古原。","pinyin":"qū chē dēng gǔ yuán","chars":[{"char":"驱","pinyin":"qū"},{"char":"车","pinyin":"chē"},{"char":"登","pinyin":"dēng"},{"char":"古","pinyin":"gǔ"},{"char":"原","pinyin":"yuán"},{"char":"。","pinyin":null}]},{"text":"夕阳无限好，","pinyin":"xī yáng wú xiàn hǎo","chars":[{"char":"夕","pinyin":"xī"},{"char":"阳","pinyin":"yáng"},{"char":"无","pinyin":"wú"},{"char":"限","pinyin":"xiàn"},{"char":"好","pinyin":"hǎo"},{"char":"，","pinyin":null}]},{"text":"只是近黄昏。","pinyin":"zhǐ shì jìn huáng hūn","chars":[{"char":"只","pinyin":"zhǐ"},{"char":"是","pinyin":"shì"},{"char":"近","pinyin":"jìn"},{"char":"黄","pinyin":"huáng"},{"char":"昏","pinyin":"hūn"},{"char":"。","pinyin":null}]}]}