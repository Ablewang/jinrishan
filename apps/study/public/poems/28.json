{"id":28,"title":"春夜喜雨","dynasty":"唐","author":"杜甫","lines":[{"text":"好雨知时节，","pinyin":"hǎo yǔ zhī shí jié","chars":[{"char":"好","pinyin":"hǎo"},{"char":"雨","pinyin":"yǔ"},{"char":"知","pinyin":"zhī"},{"char":"时","pinyin":"shí"},{"char":"节","pinyin":"jié"},{"char":"，","pinyin":null}]},{"text":"当春乃发生。","pinyin":"dāng chūn nǎi fā shēng","chars":[{"char":"当","pinyin":"dāng"},{"char":"春","pinyin":"chūn"},{"char":"乃","pinyin":"nǎi"},{"char":"发","pinyin":"fā"},{"char":"生","pinyin":"shēng"},{"char":"。","pinyin":null}]},{"text":"随风潜入夜，","pinyin":"suí fēng qián rù yè","chars":[{"char":"随","pinyin":"suí"},{"char":"风","pinyin":"fēng"},{"char":"潜","pinyin":"qián"},{"char":"入","pinyin":"rù"},{"char":"夜","pinyin":"yè"},{"char":"，","pinyin":null}]},{"text":"润物细无声。","pinyin":"rùn wù xì wú shēng","chars":[{"char":"润","pinyin":"rùn"},{"char":"物","pinyin":"wù"},{"char":"细","pinyin":"xì"},{"char":"无","pinyin":"wú"},{"char":"声","pinyin":"shēng"},{"char":"。","pinyin":null}]},{"text":"野径云俱黑，","pinyin":"yě jìng yún jù hēi","chars":[{"char":"野","pinyin":"yě"},{"char":"径","pinyin":"jìng"},{"char":"云","pinyin":"yún"},{"char":"俱","pinyin":"jù"},{"char":"黑","pinyin":"hēi"},{"char":"，","pinyin":null}]},{"text":"江船火独明。","pinyin":"jiāng chuán huǒ dú míng","chars":[{"char":"江","pinyin":"jiāng"},{"char":"船","pinyin":"chuán"},{"char":"火","pinyin":"huǒ"},{"char":"独","pinyin":"dú"},{"char":"明","pinyin":"míng"},{"char":"。","pinyin":null}]},{"text":"晓看红湿处，","pinyin":"xiǎo kàn hóng shī chù","chars":[{"char":"晓","pinyin":"xiǎo"},{"char":"看","pinyin":"kàn"},{"char":"红","pinyin":"hóng"},{"char":"湿","pinyin":"shī"},{"char":"处","pinyin":"chù"},{"char":"，","pinyin":null}]},{"text":"花重锦官城。","pinyin":"huā zhòng jǐn guān chéng","chars":[{"char":"花","pinyin":"huā"},{"char":"重","pinyin":"zhòng"},{"char":"锦","pinyin":"jǐn"},{"char":"官","pinyin":"guān"},{"char":"城","pinyin":"chéng"},{"char":"。","pinyin":null}]}],"titlePinyin":["chūn","yè","xǐ","yǔ"]}