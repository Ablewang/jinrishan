{"id":69,"title":"墨梅","dynasty":"元","author":"王冕","lines":[{"text":"吾家洗砚池头树，","pinyin":"wú jiā xǐ yàn chí tóu shù","chars":[{"char":"吾","pinyin":"wú"},{"char":"家","pinyin":"jiā"},{"char":"洗","pinyin":"xǐ"},{"char":"砚","pinyin":"yàn"},{"char":"池","pinyin":"chí"},{"char":"头","pinyin":"tóu"},{"char":"树","pinyin":"shù"},{"char":"，","pinyin":null}]},{"text":"朵朵花开淡墨痕。","pinyin":"duǒ duǒ huā kāi dàn mò hén","chars":[{"char":"朵","pinyin":"duǒ"},{"char":"朵","pinyin":"duǒ"},{"char":"花","pinyin":"huā"},{"char":"开","pinyin":"kāi"},{"char":"淡","pinyin":"dàn"},{"char":"墨","pinyin":"mò"},{"char":"痕","pinyin":"hén"},{"char":"。","pinyin":null}]},{"text":"不要人夸好颜色，","pinyin":"bú yào rén kuā hǎo yán sè","chars":[{"char":"不","pinyin":"bú"},{"char":"要","pinyin":"yào"},{"char":"人","pinyin":"rén"},{"char":"夸","pinyin":"kuā"},{"char":"好","pinyin":"hǎo"},{"char":"颜","pinyin":"yán"},{"char":"色","pinyin":"sè"},{"char":"，","pinyin":null}]},{"text":"只留清气满乾坤。","pinyin":"zhǐ liú qīng qì mǎn qián kūn","chars":[{"char":"只","pinyin":"zhǐ"},{"char":"留","pinyin":"liú"},{"char":"清","pinyin":"qīng"},{"char":"气","pinyin":"qì"},{"char":"满","pinyin":"mǎn"},{"char":"乾","pinyin":"qián"},{"char":"坤","pinyin":"kūn"},{"char":"。","pinyin":null}]}],"titlePinyin":["mò","méi"]}