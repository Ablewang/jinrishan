{"id":34,"title":"渔歌子","dynasty":"唐","author":"张志和","lines":[{"text":"西塞山前白鹭飞，","pinyin":"xī sāi shān qián bái lù fēi","chars":[{"char":"西","pinyin":"xī"},{"char":"塞","pinyin":"sāi"},{"char":"山","pinyin":"shān"},{"char":"前","pinyin":"qián"},{"char":"白","pinyin":"bái"},{"char":"鹭","pinyin":"lù"},{"char":"飞","pinyin":"fēi"},{"char":"，","pinyin":null}]},{"text":"桃花流水鳜鱼肥。","pinyin":"táo huā liú shuǐ guì yú féi","chars":[{"char":"桃","pinyin":"táo"},{"char":"花","pinyin":"huā"},{"char":"流","pinyin":"liú"},{"char":"水","pinyin":"shuǐ"},{"char":"鳜","pinyin":"guì"},{"char":"鱼","pinyin":"yú"},{"char":"肥","pinyin":"féi"},{"char":"。","pinyin":null}]},{"text":"青箬笠，绿蓑衣，","pinyin":"qīng ruò lì lǜ suō yī","chars":[{"char":"青","pinyin":"qīng"},{"char":"箬","pinyin":"ruò"},{"char":"笠","pinyin":"lì"},{"char":"，","pinyin":null},{"char":"绿","pinyin":"lǜ"},{"char":"蓑","pinyin":"suō"},{"char":"衣","pinyin":"yī"},{"char":"，","pinyin":null}]},{"text":"斜风细雨不须归。","pinyin":"xié fēng xì yǔ bù xū guī","chars":[{"char":"斜","pinyin":"xié"},{"char":"风","pinyin":"fēng"},{"char":"细","pinyin":"xì"},{"char":"雨","pinyin":"yǔ"},{"char":"不","pinyin":"bù"},{"char":"须","pinyin":"xū"},{"char":"归","pinyin":"guī"},{"char":"。","pinyin":null}]}],"titlePinyin":["yú","gē","zǐ"]}