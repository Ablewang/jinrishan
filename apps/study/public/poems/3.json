{"id":3,"title":"敕勒歌","dynasty":null,"author":"北朝民歌","lines":[{"text":"敕勒川，阴山下。","pinyin":"chì lè chuān yīn shān xià","chars":[{"char":"敕","pinyin":"chì"},{"char":"勒","pinyin":"lè"},{"char":"川","pinyin":"chuān"},{"char":"，","pinyin":null},{"char":"阴","pinyin":"yīn"},{"char":"山","pinyin":"shān"},{"char":"下","pinyin":"xià"},{"char":"。","pinyin":null}]},{"text":"天似穹庐，笼盖四野。","pinyin":"tiān sì qióng lú lóng gài sì yě","chars":[{"char":"天","pinyin":"tiān"},{"char":"似","pinyin":"sì"},{"char":"穹","pinyin":"qióng"},{"char":"庐","pinyin":"lú"},{"char":"，","pinyin":null},{"char":"笼","pinyin":"lóng"},{"char":"盖","pinyin":"gài"},{"char":"四","pinyin":"sì"},{"char":"野","pinyin":"yě"},{"char":"。","pinyin":null}]},{"text":"天苍苍，野茫茫，","pinyin":"tiān cāng cāng yě máng máng","chars":[{"char":"天","pinyin":"tiān"},{"char":"苍","pinyin":"cāng"},{"char":"苍","pinyin":"cāng"},{"char":"，","pinyin":null},{"char":"野","pinyin":"yě"},{"char":"茫","pinyin":"máng"},{"char":"茫","pinyin":"máng"},{"char":"，","pinyin":null}]},{"text":"风吹草低见牛羊。","pinyin":"fēng chuī cǎo dī jiàn niú yáng","chars":[{"char":"风","pinyin":"fēng"},{"char":"吹","pinyin":"chuī"},{"char":"草","pinyin":"cǎo"},{"char":"低","pinyin":"dī"},{"char":"见","pinyin":"jiàn"},{"char":"牛","pinyin":"niú"},{"char":"羊","pinyin":"yáng"},{"char":"。","pinyin":null}]}],"titlePinyin":["chì","lè","gē"]}