{"id":35,"title":"塞下曲","dynasty":"唐","author":"卢纶","lines":[{"text":"月黑雁飞高，","pinyin":"yuè hēi yàn fēi gāo","chars":[{"char":"月","pinyin":"yuè"},{"char":"黑","pinyin":"hēi"},{"char":"雁","pinyin":"yàn"},{"char":"飞","pinyin":"fēi"},{"char":"高","pinyin":"gāo"},{"char":"，","pinyin":null}]},{"text":"单于夜遁逃。","pinyin":"chán yú yè dùn táo","chars":[{"char":"单","pinyin":"chán"},{"char":"于","pinyin":"yú"},{"char":"夜","pinyin":"yè"},{"char":"遁","pinyin":"dùn"},{"char":"逃","pinyin":"táo"},{"char":"。","pinyin":null}]},{"text":"欲将轻骑逐，","pinyin":"yù jiàng qīng qí zhú","chars":[{"char":"欲","pinyin":"yù"},{"char":"将","pinyin":"jiàng"},{"char":"轻","pinyin":"qīng"},{"char":"骑","pinyin":"qí"},{"char":"逐","pinyin":"zhú"},{"char":"，","pinyin":null}]},{"text":"大雪满弓刀。","pinyin":"dà xuě mǎn gōng dāo","chars":[{"char":"大","pinyin":"dà"},{"char":"雪","pinyin":"xuě"},{"char":"满","pinyin":"mǎn"},{"char":"弓","pinyin":"gōng"},{"char":"刀","pinyin":"dāo"},{"char":"。","pinyin":null}]}],"titlePinyin":["sāi","xià","qǔ"]}