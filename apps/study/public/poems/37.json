{"id":37,"title":"浪淘沙","dynasty":"唐","author":"刘禹锡","lines":[{"text":"九曲黄河万里沙，","pinyin":"jiǔ qū huáng hé wàn lǐ shā","chars":[{"char":"九","pinyin":"jiǔ"},{"char":"曲","pinyin":"qū"},{"char":"黄","pinyin":"huáng"},{"char":"河","pinyin":"hé"},{"char":"万","pinyin":"wàn"},{"char":"里","pinyin":"lǐ"},{"char":"沙","pinyin":"shā"},{"char":"，","pinyin":null}]},{"text":"浪淘风簸自天涯。","pinyin":"làng táo fēng bǒ zì tiān yá","chars":[{"char":"浪","pinyin":"làng"},{"char":"淘","pinyin":"táo"},{"char":"风","pinyin":"fēng"},{"char":"簸","pinyin":"bǒ"},{"char":"自","pinyin":"zì"},{"char":"天","pinyin":"tiān"},{"char":"涯","pinyin":"yá"},{"char":"。","pinyin":null}]},{"text":"如今直上银河去，","pinyin":"rú jīn zhí shàng yín hé qù","chars":[{"char":"如","pinyin":"rú"},{"char":"今","pinyin":"jīn"},{"char":"直","pinyin":"zhí"},{"char":"上","pinyin":"shàng"},{"char":"银","pinyin":"yín"},{"char":"河","pinyin":"hé"},{"char":"去","pinyin":"qù"},{"char":"，","pinyin":null}]},{"text":"同到牵牛织女家。","pinyin":"tóng dào qiān niú zhī nǚ jiā","chars":[{"char":"同","pinyin":"tóng"},{"char":"到","pinyin":"dào"},{"char":"牵","pinyin":"qiān"},{"char":"牛","pinyin":"niú"},{"char":"织","pinyin":"zhī"},{"char":"女","pinyin":"nǚ"},{"char":"家","pinyin":"jiā"},{"char":"。","pinyin":null}]}]}