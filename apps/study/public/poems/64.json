{"id":64,"title":"晓出净慈寺送林子方","dynasty":"宋","author":"杨万里","lines":[{"text":"毕竟西湖六月中，","pinyin":"bì jìng xī hú liù yuè zhōng","chars":[{"char":"毕","pinyin":"bì"},{"char":"竟","pinyin":"jìng"},{"char":"西","pinyin":"xī"},{"char":"湖","pinyin":"hú"},{"char":"六","pinyin":"liù"},{"char":"月","pinyin":"yuè"},{"char":"中","pinyin":"zhōng"},{"char":"，","pinyin":null}]},{"text":"风光不与四时同。","pinyin":"fēng guāng bù yǔ sì shí tóng","chars":[{"char":"风","pinyin":"fēng"},{"char":"光","pinyin":"guāng"},{"char":"不","pinyin":"bù"},{"char":"与","pinyin":"yǔ"},{"char":"四","pinyin":"sì"},{"char":"时","pinyin":"shí"},{"char":"同","pinyin":"tóng"},{"char":"。","pinyin":null}]},{"text":"接天莲叶无穷碧，","pinyin":"jiē tiān lián yè wú qióng bì","chars":[{"char":"接","pinyin":"jiē"},{"char":"天","pinyin":"tiān"},{"char":"莲","pinyin":"lián"},{"char":"叶","pinyin":"yè"},{"char":"无","pinyin":"wú"},{"char":"穷","pinyin":"qióng"},{"char":"碧","pinyin":"bì"},{"char":"，","pinyin":null}]},{"text":"映日荷花别样红。","pinyin":"yìng rì hé huā bié yàng hóng","chars":[{"char":"映","pinyin":"yìng"},{"char":"日","pinyin":"rì"},{"char":"荷","pinyin":"hé"},{"char":"花","pinyin":"huā"},{"char":"别","pinyin":"bié"},{"char":"样","pinyin":"yàng"},{"char":"红","pinyin":"hóng"},{"char":"。","pinyin":null}]}],"titlePinyin":["xiǎo","chū","jìng","cí","sì","sòng","lín","zi","fāng"]}