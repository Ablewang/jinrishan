{"id":59,"title":"示儿","dynasty":"宋","author":"陆游","lines":[{"text":"死去元知万事空，","pinyin":"sǐ qù yuán zhī wàn shì kōng","chars":[{"char":"死","pinyin":"sǐ"},{"char":"去","pinyin":"qù"},{"char":"元","pinyin":"yuán"},{"char":"知","pinyin":"zhī"},{"char":"万","pinyin":"wàn"},{"char":"事","pinyin":"shì"},{"char":"空","pinyin":"kōng"},{"char":"，","pinyin":null}]},{"text":"但悲不见九州同。","pinyin":"dàn bēi bú jiàn jiǔ zhōu tóng","chars":[{"char":"但","pinyin":"dàn"},{"char":"悲","pinyin":"bēi"},{"char":"不","pinyin":"bú"},{"char":"见","pinyin":"jiàn"},{"char":"九","pinyin":"jiǔ"},{"char":"州","pinyin":"zhōu"},{"char":"同","pinyin":"tóng"},{"char":"。","pinyin":null}]},{"text":"王师北定中原日，","pinyin":"wáng shī běi dìng zhōng yuán rì","chars":[{"char":"王","pinyin":"wáng"},{"char":"师","pinyin":"shī"},{"char":"北","pinyin":"běi"},{"char":"定","pinyin":"dìng"},{"char":"中","pinyin":"zhōng"},{"char":"原","pinyin":"yuán"},{"char":"日","pinyin":"rì"},{"char":"，","pinyin":null}]},{"text":"家祭无忘告乃翁。","pinyin":"jiā jì wú wàng gào nǎi wēng","chars":[{"char":"家","pinyin":"jiā"},{"char":"祭","pinyin":"jì"},{"char":"无","pinyin":"wú"},{"char":"忘","pinyin":"wàng"},{"char":"告","pinyin":"gào"},{"char":"乃","pinyin":"nǎi"},{"char":"翁","pinyin":"wēng"},{"char":"。","pinyin":null}]}]}