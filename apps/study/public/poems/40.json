{"id":40,"title":"忆江南","dynasty":"唐","author":"白居易","lines":[{"text":"江南好，","pinyin":"jiāng nán hǎo","chars":[{"char":"江","pinyin":"jiāng"},{"char":"南","pinyin":"nán"},{"char":"好","pinyin":"hǎo"},{"char":"，","pinyin":null}]},{"text":"风景旧曾谙。","pinyin":"fēng jǐng jiù céng ān","chars":[{"char":"风","pinyin":"fēng"},{"char":"景","pinyin":"jǐng"},{"char":"旧","pinyin":"jiù"},{"char":"曾","pinyin":"céng"},{"char":"谙","pinyin":"ān"},{"char":"。","pinyin":null}]},{"text":"日出江花红胜火，","pinyin":"rì chū jiāng huā hóng shèng huǒ","chars":[{"char":"日","pinyin":"rì"},{"char":"出","pinyin":"chū"},{"char":"江","pinyin":"jiāng"},{"char":"花","pinyin":"huā"},{"char":"红","pinyin":"hóng"},{"char":"胜","pinyin":"shèng"},{"char":"火","pinyin":"huǒ"},{"char":"，","pinyin":null}]},{"text":"春来江水绿如蓝。","pinyin":"chūn lái jiāng shuǐ lǜ rú lán","chars":[{"char":"春","pinyin":"chūn"},{"char":"来","pinyin":"lái"},{"char":"江","pinyin":"jiāng"},{"char":"水","pinyin":"shuǐ"},{"char":"绿","pinyin":"lǜ"},{"char":"如","pinyin":"rú"},{"char":"蓝","pinyin":"lán"},{"char":"。","pinyin":null}]},{"text":"能不忆江南？","pinyin":"néng bù yì jiāng nán","chars":[{"char":"能","pinyin":"néng"},{"char":"不","pinyin":"bù"},{"char":"忆","pinyin":"yì"},{"char":"江","pinyin":"jiāng"},{"char":"南","pinyin":"nán"},{"char":"？","pinyin":null}]}],"titlePinyin":["yì","jiāng","nán"]}