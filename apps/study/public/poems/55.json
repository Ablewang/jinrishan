{"id":55,"title":"饮湖上初晴后雨","dynasty":"宋","author":"苏轼","lines":[{"text":"水光潋滟晴方好，","pinyin":"shuǐ guāng liàn yàn qíng fāng hǎo","chars":[{"char":"水","pinyin":"shuǐ"},{"char":"光","pinyin":"guāng"},{"char":"潋","pinyin":"liàn"},{"char":"滟","pinyin":"yàn"},{"char":"晴","pinyin":"qíng"},{"char":"方","pinyin":"fāng"},{"char":"好","pinyin":"hǎo"},{"char":"，","pinyin":null}]},{"text":"山色空蒙雨亦奇。","pinyin":"shān sè kōng méng yǔ yì qí","chars":[{"char":"山","pinyin":"shān"},{"char":"色","pinyin":"sè"},{"char":"空","pinyin":"kōng"},{"char":"蒙","pinyin":"méng"},{"char":"雨","pinyin":"yǔ"},{"char":"亦","pinyin":"yì"},{"char":"奇","pinyin":"qí"},{"char":"。","pinyin":null}]},{"text":"欲把西湖比西子，","pinyin":"yù bǎ xī hú bǐ xī zǐ","chars":[{"char":"欲","pinyin":"yù"},{"char":"把","pinyin":"bǎ"},{"char":"西","pinyin":"xī"},{"char":"湖","pinyin":"hú"},{"char":"比","pinyin":"bǐ"},{"char":"西","pinyin":"xī"},{"char":"子","pinyin":"zǐ"},{"char":"，","pinyin":null}]},{"text":"淡妆浓抹总相宜。","pinyin":"dàn zhuāng nóng mǒ zǒng xiāng yí","chars":[{"char":"淡","pinyin":"dàn"},{"char":"妆","pinyin":"zhuāng"},{"char":"浓","pinyin":"nóng"},{"char":"抹","pinyin":"mǒ"},{"char":"总","pinyin":"zǒng"},{"char":"相","pinyin":"xiāng"},{"char":"宜","pinyin":"yí"},{"char":"。","pinyin":null}]}]}