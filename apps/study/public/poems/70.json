{"id":70,"title":"石灰吟","dynasty":"明","author":"于谦","lines":[{"text":"千锤万凿出深山，","pinyin":"qiān chuí wàn záo chū shēn shān","chars":[{"char":"千","pinyin":"qiān"},{"char":"锤","pinyin":"chuí"},{"char":"万","pinyin":"wàn"},{"char":"凿","pinyin":"záo"},{"char":"出","pinyin":"chū"},{"char":"深","pinyin":"shēn"},{"char":"山","pinyin":"shān"},{"char":"，","pinyin":null}]},{"text":"烈火焚烧若等闲。","pinyin":"liè huǒ fén shāo ruò děng xián","chars":[{"char":"烈","pinyin":"liè"},{"char":"火","pinyin":"huǒ"},{"char":"焚","pinyin":"fén"},{"char":"烧","pinyin":"shāo"},{"char":"若","pinyin":"ruò"},{"char":"等","pinyin":"děng"},{"char":"闲","pinyin":"xián"},{"char":"。","pinyin":null}]},{"text":"粉骨碎身浑不怕，","pinyin":"fěn gǔ suì shēn hún bú pà","chars":[{"char":"粉","pinyin":"fěn"},{"char":"骨","pinyin":"gǔ"},{"char":"碎","pinyin":"suì"},{"char":"身","pinyin":"shēn"},{"char":"浑","pinyin":"hún"},{"char":"不","pinyin":"bú"},{"char":"怕","pinyin":"pà"},{"char":"，","pinyin":null}]},{"text":"要留清白在人间。","pinyin":"yào liú qīng bái zài rén jiān","chars":[{"char":"要","pinyin":"yào"},{"char":"留","pinyin":"liú"},{"char":"清","pinyin":"qīng"},{"char":"白","pinyin":"bái"},{"char":"在","pinyin":"zài"},{"char":"人","pinyin":"rén"},{"char":"间","pinyin":"jiān"},{"char":"。","pinyin":null}]}]}