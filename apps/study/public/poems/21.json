{"id":21,"title":"望庐山瀑布","dynasty":"唐","author":"李白","lines":[{"text":"日照香炉生紫烟，","pinyin":"rì zhào xiāng lú shēng zǐ yān","chars":[{"char":"日","pinyin":"rì"},{"char":"照","pinyin":"zhào"},{"char":"香","pinyin":"xiāng"},{"char":"炉","pinyin":"lú"},{"char":"生","pinyin":"shēng"},{"char":"紫","pinyin":"zǐ"},{"char":"烟","pinyin":"yān"},{"char":"，","pinyin":null}]},{"text":"遥看瀑布挂前川。","pinyin":"yáo kàn pù bù guà qián chuān","chars":[{"char":"遥","pinyin":"yáo"},{"char":"看","pinyin":"kàn"},{"char":"瀑","pinyin":"pù"},{"char":"布","pinyin":"bù"},{"char":"挂","pinyin":"guà"},{"char":"前","pinyin":"qián"},{"char":"川","pinyin":"chuān"},{"char":"。","pinyin":null}]},{"text":"飞流直下三千尺，","pinyin":"fēi liú zhí xià sān qiān chǐ","chars":[{"char":"飞","pinyin":"fēi"},{"char":"流","pinyin":"liú"},{"char":"直","pinyin":"zhí"},{"char":"下","pinyin":"xià"},{"char":"三","pinyin":"sān"},{"char":"千","pinyin":"qiān"},{"char":"尺","pinyin":"chǐ"},{"char":"，","pinyin":null}]},{"text":"疑是银河落九天。","pinyin":"yí shì yín hé luò jiǔ tiān","chars":[{"char":"疑","pinyin":"yí"},{"char":"是","pinyin":"shì"},{"char":"银","pinyin":"yín"},{"char":"河","pinyin":"hé"},{"char":"落","pinyin":"luò"},{"char":"九","pinyin":"jiǔ"},{"char":"天","pinyin":"tiān"},{"char":"。","pinyin":null}]}],"titlePinyin":["wàng","lú","shān","pù","bù"]}