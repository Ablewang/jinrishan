{"id":25,"title":"望天门山","dynasty":"唐","author":"李白","lines":[{"text":"天门中断楚江开，","pinyin":"tiān mén zhōng duàn chǔ jiāng kāi","chars":[{"char":"天","pinyin":"tiān"},{"char":"门","pinyin":"mén"},{"char":"中","pinyin":"zhōng"},{"char":"断","pinyin":"duàn"},{"char":"楚","pinyin":"chǔ"},{"char":"江","pinyin":"jiāng"},{"char":"开","pinyin":"kāi"},{"char":"，","pinyin":null}]},{"text":"碧水东流至此回。","pinyin":"bì shuǐ dōng liú zhì cǐ huí","chars":[{"char":"碧","pinyin":"bì"},{"char":"水","pinyin":"shuǐ"},{"char":"东","pinyin":"dōng"},{"char":"流","pinyin":"liú"},{"char":"至","pinyin":"zhì"},{"char":"此","pinyin":"cǐ"},{"char":"回","pinyin":"huí"},{"char":"。","pinyin":null}]},{"text":"两岸青山相对出，","pinyin":"liǎng àn qīng shān xiāng duì chū","chars":[{"char":"两","pinyin":"liǎng"},{"char":"岸","pinyin":"àn"},{"char":"青","pinyin":"qīng"},{"char":"山","pinyin":"shān"},{"char":"相","pinyin":"xiāng"},{"char":"对","pinyin":"duì"},{"char":"出","pinyin":"chū"},{"char":"，","pinyin":null}]},{"text":"孤帆一片日边来。","pinyin":"gū fān yí piàn rì biān lái","chars":[{"char":"孤","pinyin":"gū"},{"char":"帆","pinyin":"fān"},{"char":"一","pinyin":"yí"},{"char":"片","pinyin":"piàn"},{"char":"日","pinyin":"rì"},{"char":"边","pinyin":"biān"},{"char":"来","pinyin":"lái"},{"char":"。","pinyin":null}]}],"titlePinyin":["wàng","tiān","mén","shān"]}