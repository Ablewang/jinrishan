{"id":20,"title":"古朗月行(节选)","dynasty":"唐","author":"李白","lines":[{"text":"小时不识月，","pinyin":"xiǎo shí bù shí yuè","chars":[{"char":"小","pinyin":"xiǎo"},{"char":"时","pinyin":"shí"},{"char":"不","pinyin":"bù"},{"char":"识","pinyin":"shí"},{"char":"月","pinyin":"yuè"},{"char":"，","pinyin":null}]},{"text":"呼作白玉盘。","pinyin":"hū zuò bái yù pán","chars":[{"char":"呼","pinyin":"hū"},{"char":"作","pinyin":"zuò"},{"char":"白","pinyin":"bái"},{"char":"玉","pinyin":"yù"},{"char":"盘","pinyin":"pán"},{"char":"。","pinyin":null}]},{"text":"又疑瑶台镜，","pinyin":"yòu yí yáo tái jìng","chars":[{"char":"又","pinyin":"yòu"},{"char":"疑","pinyin":"yí"},{"char":"瑶","pinyin":"yáo"},{"char":"台","pinyin":"tái"},{"char":"镜","pinyin":"jìng"},{"char":"，","pinyin":null}]},{"text":"飞在青云端。","pinyin":"fēi zài qīng yún duān","chars":[{"char":"飞","pinyin":"fēi"},{"char":"在","pinyin":"zài"},{"char":"青","pinyin":"qīng"},{"char":"云","pinyin":"yún"},{"char":"端","pinyin":"duān"},{"char":"。","pinyin":null}]}],"titlePinyin":["gǔ","lǎng","yuè","xíng","(","jié","xuǎn",")"]}