{"id":9,"title":"登鹳雀楼","dynasty":"唐","author":"王之涣","lines":[{"text":"白日依山尽，","pinyin":"bái rì yī shān jìn","chars":[{"char":"白","pinyin":"bái"},{"char":"日","pinyin":"rì"},{"char":"依","pinyin":"yī"},{"char":"山","pinyin":"shān"},{"char":"尽","pinyin":"jìn"},{"char":"，","pinyin":null}]},{"text":"黄河入海流。","pinyin":"huáng hé rù hǎi liú","chars":[{"char":"黄","pinyin":"huáng"},{"char":"河","pinyin":"hé"},{"char":"入","pinyin":"rù"},{"char":"海","pinyin":"hǎi"},{"char":"流","pinyin":"liú"},{"char":"。","pinyin":null}]},{"text":"欲穷千里目，","pinyin":"yù qióng qiān lǐ mù","chars":[{"char":"欲","pinyin":"yù"},{"char":"穷","pinyin":"qióng"},{"char":"千","pinyin":"qiān"},{"char":"里","pinyin":"lǐ"},{"char":"目","pinyin":"mù"},{"char":"，","pinyin":null}]},{"text":"更上一层楼。","pinyin":"gèng shàng yì céng lóu","chars":[{"char":"更","pinyin":"gèng"},{"char":"上","pinyin":"shàng"},{"char":"一","pinyin":"yì"},{"char":"层","pinyin":"céng"},{"char":"楼","pinyin":"lóu"},{"char":"。","pinyin":null}]}]}