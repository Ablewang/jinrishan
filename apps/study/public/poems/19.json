{"id":19,"title":"静夜思","dynasty":"唐","author":"李白","lines":[{"text":"床前明月光，","pinyin":"chuáng qián míng yuè guāng","chars":[{"char":"床","pinyin":"chuáng"},{"char":"前","pinyin":"qián"},{"char":"明","pinyin":"míng"},{"char":"月","pinyin":"yuè"},{"char":"光","pinyin":"guāng"},{"char":"，","pinyin":null}]},{"text":"疑是地上霜。","pinyin":"yí shì dì shàng shuāng","chars":[{"char":"疑","pinyin":"yí"},{"char":"是","pinyin":"shì"},{"char":"地","pinyin":"dì"},{"char":"上","pinyin":"shàng"},{"char":"霜","pinyin":"shuāng"},{"char":"。","pinyin":null}]},{"text":"举头望明月，","pinyin":"jǔ tóu wàng míng yuè","chars":[{"char":"举","pinyin":"jǔ"},{"char":"头","pinyin":"tóu"},{"char":"望","pinyin":"wàng"},{"char":"明","pinyin":"míng"},{"char":"月","pinyin":"yuè"},{"char":"，","pinyin":null}]},{"text":"低头思故乡。","pinyin":"dī tóu sī gù xiāng","chars":[{"char":"低","pinyin":"dī"},{"char":"头","pinyin":"tóu"},{"char":"思","pinyin":"sī"},{"char":"故","pinyin":"gù"},{"char":"乡","pinyin":"xiāng"},{"char":"。","pinyin":null}]}]}