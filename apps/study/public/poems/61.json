{"id":61,"title":"四时田园杂兴（其三十一）","dynasty":"宋","author":"范成大","lines":[{"text":"昼出耘田夜绩麻，","pinyin":"zhòu chū yún tián yè jì má","chars":[{"char":"昼","pinyin":"zhòu"},{"char":"出","pinyin":"chū"},{"char":"耘","pinyin":"yún"},{"char":"田","pinyin":"tián"},{"char":"夜","pinyin":"yè"},{"char":"绩","pinyin":"jì"},{"char":"麻","pinyin":"má"},{"char":"，","pinyin":null}]},{"text":"村庄儿女各当家。","pinyin":"cūn zhuāng ér nǚ gè dāng jiā","chars":[{"char":"村","pinyin":"cūn"},{"char":"庄","pinyin":"zhuāng"},{"char":"儿","pinyin":"ér"},{"char":"女","pinyin":"nǚ"},{"char":"各","pinyin":"gè"},{"char":"当","pinyin":"dāng"},{"char":"家","pinyin":"jiā"},{"char":"。","pinyin":null}]},{"text":"童孙未解供耕织，","pinyin":"tóng sūn wèi jiě gòng gēng zhī","chars":[{"char":"童","pinyin":"tóng"},{"char":"孙","pinyin":"sūn"},{"char":"未","pinyin":"wèi"},{"char":"解","pinyin":"jiě"},{"char":"供","pinyin":"gòng"},{"char":"耕","pinyin":"gēng"},{"char":"织","pinyin":"zhī"},{"char":"，","pinyin":null}]},{"text":"也傍桑阴学种瓜。","pinyin":"yě bàng sāng yīn xué zhǒng guā","chars":[{"char":"也","pinyin":"yě"},{"char":"傍","pinyin":"bàng"},{"char":"桑","pinyin":"sāng"},{"char":"阴","pinyin":"yīn"},{"char":"学","pinyin":"xué"},{"char":"种","pinyin":"zhǒng"},{"char":"瓜","pinyin":"guā"},{"char":"。","pinyin":null}]}]}