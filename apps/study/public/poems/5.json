{"id":5,"title":"风","dynasty":"唐","author":"李峤","lines":[{"text":"解落三秋叶，","pinyin":"jiě luò sān qiū yè","chars":[{"char":"解","pinyin":"jiě"},{"char":"落","pinyin":"luò"},{"char":"三","pinyin":"sān"},{"char":"秋","pinyin":"qiū"},{"char":"叶","pinyin":"yè"},{"char":"，","pinyin":null}]},{"text":"能开二月花。","pinyin":"néng kāi èr yuè huā","chars":[{"char":"能","pinyin":"néng"},{"char":"开","pinyin":"kāi"},{"char":"二","pinyin":"èr"},{"char":"月","pinyin":"yuè"},{"char":"花","pinyin":"huā"},{"char":"。","pinyin":null}]},{"text":"过江千尺浪，","pinyin":"guò jiāng qiān chǐ làng","chars":[{"char":"过","pinyin":"guò"},{"char":"江","pinyin":"jiāng"},{"char":"千","pinyin":"qiān"},{"char":"尺","pinyin":"chǐ"},{"char":"浪","pinyin":"làng"},{"char":"，","pinyin":null}]},{"text":"入竹万竿斜。","pinyin":"rù zhú wàn gān xié","chars":[{"char":"入","pinyin":"rù"},{"char":"竹","pinyin":"zhú"},{"char":"万","pinyin":"wàn"},{"char":"竿","pinyin":"gān"},{"char":"斜","pinyin":"xié"},{"char":"。","pinyin":null}]}]}