{"id":14,"title":"芙蓉楼送辛渐","dynasty":"唐","author":"王昌龄","lines":[{"text":"寒雨连江夜入吴，","pinyin":"hán yǔ lián jiāng yè rù wú","chars":[{"char":"寒","pinyin":"hán"},{"char":"雨","pinyin":"yǔ"},{"char":"连","pinyin":"lián"},{"char":"江","pinyin":"jiāng"},{"char":"夜","pinyin":"yè"},{"char":"入","pinyin":"rù"},{"char":"吴","pinyin":"wú"},{"char":"，","pinyin":null}]},{"text":"平明送客楚山孤。","pinyin":"píng míng sòng kè chǔ shān gū","chars":[{"char":"平","pinyin":"píng"},{"char":"明","pinyin":"míng"},{"char":"送","pinyin":"sòng"},{"char":"客","pinyin":"kè"},{"char":"楚","pinyin":"chǔ"},{"char":"山","pinyin":"shān"},{"char":"孤","pinyin":"gū"},{"char":"。","pinyin":null}]},{"text":"洛阳亲友如相问，","pinyin":"luò yáng qīn yǒu rú xiāng wèn","chars":[{"char":"洛","pinyin":"luò"},{"char":"阳","pinyin":"yáng"},{"char":"亲","pinyin":"qīn"},{"char":"友","pinyin":"yǒu"},{"char":"如","pinyin":"rú"},{"char":"相","pinyin":"xiāng"},{"char":"问","pinyin":"wèn"},{"char":"，","pinyin":null}]},{"text":"一片冰心在玉壶。","pinyin":"yí piàn bīng xīn zài yù hú","chars":[{"char":"一","pinyin":"yí"},{"char":"片","pinyin":"piàn"},{"char":"冰","pinyin":"bīng"},{"char":"心","pinyin":"xīn"},{"char":"在","pinyin":"zài"},{"char":"玉","pinyin":"yù"},{"char":"壶","pinyin":"hú"},{"char":"。","pinyin":null}]}]}