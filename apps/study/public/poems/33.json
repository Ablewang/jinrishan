{"id":33,"title":"江雪","dynasty":"唐","author":"柳宗元","lines":[{"text":"千山鸟飞绝，","pinyin":"qiān shān niǎo fēi jué","chars":[{"char":"千","pinyin":"qiān"},{"char":"山","pinyin":"shān"},{"char":"鸟","pinyin":"niǎo"},{"char":"飞","pinyin":"fēi"},{"char":"绝","pinyin":"jué"},{"char":"，","pinyin":null}]},{"text":"万径人踪灭。","pinyin":"wàn jìng rén zōng miè","chars":[{"char":"万","pinyin":"wàn"},{"char":"径","pinyin":"jìng"},{"char":"人","pinyin":"rén"},{"char":"踪","pinyin":"zōng"},{"char":"灭","pinyin":"miè"},{"char":"。","pinyin":null}]},{"text":"孤舟蓑笠翁，","pinyin":"gū zhōu suō lì wēng","chars":[{"char":"孤","pinyin":"gū"},{"char":"舟","pinyin":"zhōu"},{"char":"蓑","pinyin":"suō"},{"char":"笠","pinyin":"lì"},{"char":"翁","pinyin":"wēng"},{"char":"，","pinyin":null}]},{"text":"独钓寒江雪。","pinyin":"dú diào hán jiāng xuě","chars":[{"char":"独","pinyin":"dú"},{"char":"钓","pinyin":"diào"},{"char":"寒","pinyin":"hán"},{"char":"江","pinyin":"jiāng"},{"char":"雪","pinyin":"xuě"},{"char":"。","pinyin":null}]}],"titlePinyin":["jiāng","xuě"]}