{"id":52,"title":"泊船瓜洲","dynasty":"宋","author":"王安石","lines":[{"text":"京口瓜洲一水间，","pinyin":"jīng kǒu guā zhōu yì shuǐ jiān","chars":[{"char":"京","pinyin":"jīng"},{"char":"口","pinyin":"kǒu"},{"char":"瓜","pinyin":"guā"},{"char":"洲","pinyin":"zhōu"},{"char":"一","pinyin":"yì"},{"char":"水","pinyin":"shuǐ"},{"char":"间","pinyin":"jiān"},{"char":"，","pinyin":null}]},{"text":"钟山只隔数重山。","pinyin":"zhōng shān zhǐ gé shù chóng shān","chars":[{"char":"钟","pinyin":"zhōng"},{"char":"山","pinyin":"shān"},{"char":"只","pinyin":"zhǐ"},{"char":"隔","pinyin":"gé"},{"char":"数","pinyin":"shù"},{"char":"重","pinyin":"chóng"},{"char":"山","pinyin":"shān"},{"char":"。","pinyin":null}]},{"text":"春风又绿江南岸，","pinyin":"chūn fēng yòu lǜ jiāng nán àn","chars":[{"char":"春","pinyin":"chūn"},{"char":"风","pinyin":"fēng"},{"char":"又","pinyin":"yòu"},{"char":"绿","pinyin":"lǜ"},{"char":"江","pinyin":"jiāng"},{"char":"南","pinyin":"nán"},{"char":"岸","pinyin":"àn"},{"char":"，","pinyin":null}]},{"text":"明月何时照我还。","pinyin":"míng yuè hé shí zhào wǒ huán","chars":[{"char":"明","pinyin":"míng"},{"char":"月","pinyin":"yuè"},{"char":"何","pinyin":"hé"},{"char":"时","pinyin":"shí"},{"char":"照","pinyin":"zhào"},{"char":"我","pinyin":"wǒ"},{"char":"还","pinyin":"huán"},{"char":"。","pinyin":null}]}]}