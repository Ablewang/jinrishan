{"id":10,"title":"春晓","dynasty":"唐","author":"孟浩然","lines":[{"text":"春眠不觉晓，","pinyin":"chūn mián bù jué xiǎo","chars":[{"char":"春","pinyin":"chūn"},{"char":"眠","pinyin":"mián"},{"char":"不","pinyin":"bù"},{"char":"觉","pinyin":"jué"},{"char":"晓","pinyin":"xiǎo"},{"char":"，","pinyin":null}]},{"text":"处处闻啼鸟。","pinyin":"chù chù wén tí niǎo","chars":[{"char":"处","pinyin":"chù"},{"char":"处","pinyin":"chù"},{"char":"闻","pinyin":"wén"},{"char":"啼","pinyin":"tí"},{"char":"鸟","pinyin":"niǎo"},{"char":"。","pinyin":null}]},{"text":"夜来风雨声，","pinyin":"yè lái fēng yǔ shēng","chars":[{"char":"夜","pinyin":"yè"},{"char":"来","pinyin":"lái"},{"char":"风","pinyin":"fēng"},{"char":"雨","pinyin":"yǔ"},{"char":"声","pinyin":"shēng"},{"char":"，","pinyin":null}]},{"text":"花落知多少。","pinyin":"huā luò zhī duō shǎo","chars":[{"char":"花","pinyin":"huā"},{"char":"落","pinyin":"luò"},{"char":"知","pinyin":"zhī"},{"char":"多","pinyin":"duō"},{"char":"少","pinyin":"shǎo"},{"char":"。","pinyin":null}]}]}