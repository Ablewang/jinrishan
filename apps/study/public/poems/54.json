{"id":54,"title":"六月二十七日望湖楼醉书","dynasty":"宋","author":"苏轼","lines":[{"text":"黑云翻墨未遮山，","pinyin":"hēi yún fān mò wèi zhē shān","chars":[{"char":"黑","pinyin":"hēi"},{"char":"云","pinyin":"yún"},{"char":"翻","pinyin":"fān"},{"char":"墨","pinyin":"mò"},{"char":"未","pinyin":"wèi"},{"char":"遮","pinyin":"zhē"},{"char":"山","pinyin":"shān"},{"char":"，","pinyin":null}]},{"text":"白雨跳珠乱入船。","pinyin":"bái yǔ tiào zhū luàn rù chuán","chars":[{"char":"白","pinyin":"bái"},{"char":"雨","pinyin":"yǔ"},{"char":"跳","pinyin":"tiào"},{"char":"珠","pinyin":"zhū"},{"char":"乱","pinyin":"luàn"},{"char":"入","pinyin":"rù"},{"char":"船","pinyin":"chuán"},{"char":"。","pinyin":null}]},{"text":"卷地风来忽吹散，","pinyin":"juǎn dì fēng lái hū chuī sàn","chars":[{"char":"卷","pinyin":"juǎn"},{"char":"地","pinyin":"dì"},{"char":"风","pinyin":"fēng"},{"char":"来","pinyin":"lái"},{"char":"忽","pinyin":"hū"},{"char":"吹","pinyin":"chuī"},{"char":"散","pinyin":"sàn"},{"char":"，","pinyin":null}]},{"text":"望湖楼下水如天。","pinyin":"wàng hú lóu xià shuǐ rú tiān","chars":[{"char":"望","pinyin":"wàng"},{"char":"湖","pinyin":"hú"},{"char":"楼","pinyin":"lóu"},{"char":"下","pinyin":"xià"},{"char":"水","pinyin":"shuǐ"},{"char":"如","pinyin":"rú"},{"char":"天","pinyin":"tiān"},{"char":"。","pinyin":null}]}],"titlePinyin":["liù","yuè","èr","shí","qī","rì","wàng","hú","lóu","zuì","shū"]}