{"id":58,"title":"夏日绝句","dynasty":"宋","author":"李清照","lines":[{"text":"生当作人杰，","pinyin":"shēng dāng zuò rén jié","chars":[{"char":"生","pinyin":"shēng"},{"char":"当","pinyin":"dāng"},{"char":"作","pinyin":"zuò"},{"char":"人","pinyin":"rén"},{"char":"杰","pinyin":"jié"},{"char":"，","pinyin":null}]},{"text":"死亦为鬼雄。","pinyin":"sǐ yì wéi guǐ xióng","chars":[{"char":"死","pinyin":"sǐ"},{"char":"亦","pinyin":"yì"},{"char":"为","pinyin":"wéi"},{"char":"鬼","pinyin":"guǐ"},{"char":"雄","pinyin":"xióng"},{"char":"。","pinyin":null}]},{"text":"至今思项羽，","pinyin":"zhì jīn sī xiàng yǔ","chars":[{"char":"至","pinyin":"zhì"},{"char":"今","pinyin":"jīn"},{"char":"思","pinyin":"sī"},{"char":"项","pinyin":"xiàng"},{"char":"羽","pinyin":"yǔ"},{"char":"，","pinyin":null}]},{"text":"不肯过江东。","pinyin":"bù kěn guò jiāng dōng","chars":[{"char":"不","pinyin":"bù"},{"char":"肯","pinyin":"kěn"},{"char":"过","pinyin":"guò"},{"char":"江","pinyin":"jiāng"},{"char":"东","pinyin":"dōng"},{"char":"。","pinyin":null}]}],"titlePinyin":["xià","rì","jué","jù"]}