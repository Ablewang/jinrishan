{"id":16,"title":"竹里馆","dynasty":"唐","author":"王维","lines":[{"text":"独坐幽篁里，","pinyin":"dú zuò yōu huáng lǐ","chars":[{"char":"独","pinyin":"dú"},{"char":"坐","pinyin":"zuò"},{"char":"幽","pinyin":"yōu"},{"char":"篁","pinyin":"huáng"},{"char":"里","pinyin":"lǐ"},{"char":"，","pinyin":null}]},{"text":"弹琴复长啸。","pinyin":"dàn qín fù cháng xiào","chars":[{"char":"弹","pinyin":"dàn"},{"char":"琴","pinyin":"qín"},{"char":"复","pinyin":"fù"},{"char":"长","pinyin":"cháng"},{"char":"啸","pinyin":"xiào"},{"char":"。","pinyin":null}]},{"text":"深林人不知，","pinyin":"shēn lín rén bù zhī","chars":[{"char":"深","pinyin":"shēn"},{"char":"林","pinyin":"lín"},{"char":"人","pinyin":"rén"},{"char":"不","pinyin":"bù"},{"char":"知","pinyin":"zhī"},{"char":"，","pinyin":null}]},{"text":"明月来相照。","pinyin":"míng yuè lái xiāng zhào","chars":[{"char":"明","pinyin":"míng"},{"char":"月","pinyin":"yuè"},{"char":"来","pinyin":"lái"},{"char":"相","pinyin":"xiāng"},{"char":"照","pinyin":"zhào"},{"char":"。","pinyin":null}]}],"titlePinyin":["zhú","lǐ","guǎn"]}