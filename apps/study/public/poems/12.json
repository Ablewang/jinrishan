{"id":12,"title":"凉州词","dynasty":"唐","author":"王翰","lines":[{"text":"葡萄美酒夜光杯，","pinyin":"pú táo měi jiǔ yè guāng bēi","chars":[{"char":"葡","pinyin":"pú"},{"char":"萄","pinyin":"táo"},{"char":"美","pinyin":"měi"},{"char":"酒","pinyin":"jiǔ"},{"char":"夜","pinyin":"yè"},{"char":"光","pinyin":"guāng"},{"char":"杯","pinyin":"bēi"},{"char":"，","pinyin":null}]},{"text":"欲饮琵琶马上催。","pinyin":"yù yǐn pí pá mǎ shàng cuī","chars":[{"char":"欲","pinyin":"yù"},{"char":"饮","pinyin":"yǐn"},{"char":"琵","pinyin":"pí"},{"char":"琶","pinyin":"pá"},{"char":"马","pinyin":"mǎ"},{"char":"上","pinyin":"shàng"},{"char":"催","pinyin":"cuī"},{"char":"。","pinyin":null}]},{"text":"醉卧沙场君莫笑，","pinyin":"zuì wò shā chǎng jūn mò xiào","chars":[{"char":"醉","pinyin":"zuì"},{"char":"卧","pinyin":"wò"},{"char":"沙","pinyin":"shā"},{"char":"场","pinyin":"chǎng"},{"char":"君","pinyin":"jūn"},{"char":"莫","pinyin":"mò"},{"char":"笑","pinyin":"xiào"},{"char":"，","pinyin":null}]},{"text":"古来征战几人回。","pinyin":"gǔ lái zhēng zhàn jǐ rén huí","chars":[{"char":"古","pinyin":"gǔ"},{"char":"来","pinyin":"lái"},{"char":"征","pinyin":"zhēng"},{"char":"战","pinyin":"zhàn"},{"char":"几","pinyin":"jǐ"},{"char":"人","pinyin":"rén"},{"char":"回","pinyin":"huí"},{"char":"。","pinyin":null}]}]}