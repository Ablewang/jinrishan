{"id":15,"title":"鹿柴","dynasty":"唐","author":"王维","lines":[{"text":"空山不见人，","pinyin":"kōng shān bú jiàn rén","chars":[{"char":"空","pinyin":"kōng"},{"char":"山","pinyin":"shān"},{"char":"不","pinyin":"bú"},{"char":"见","pinyin":"jiàn"},{"char":"人","pinyin":"rén"},{"char":"，","pinyin":null}]},{"text":"但闻人语响。","pinyin":"dàn wén rén yǔ xiǎng","chars":[{"char":"但","pinyin":"dàn"},{"char":"闻","pinyin":"wén"},{"char":"人","pinyin":"rén"},{"char":"语","pinyin":"yǔ"},{"char":"响","pinyin":"xiǎng"},{"char":"。","pinyin":null}]},{"text":"返景入深林，","pinyin":"fǎn jǐng rù shēn lín","chars":[{"char":"返","pinyin":"fǎn"},{"char":"景","pinyin":"jǐng"},{"char":"入","pinyin":"rù"},{"char":"深","pinyin":"shēn"},{"char":"林","pinyin":"lín"},{"char":"，","pinyin":null}]},{"text":"复照青苔上。","pinyin":"fù zhào qīng tái shàng","chars":[{"char":"复","pinyin":"fù"},{"char":"照","pinyin":"zhào"},{"char":"青","pinyin":"qīng"},{"char":"苔","pinyin":"tái"},{"char":"上","pinyin":"shàng"},{"char":"。","pinyin":null}]}],"titlePinyin":["lù","chái"]}