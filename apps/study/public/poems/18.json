{"id":18,"title":"九月九日忆山东兄弟","dynasty":"唐","author":"王维","lines":[{"text":"独在异乡为异客，","pinyin":"dú zài yì xiāng wéi yì kè","chars":[{"char":"独","pinyin":"dú"},{"char":"在","pinyin":"zài"},{"char":"异","pinyin":"yì"},{"char":"乡","pinyin":"xiāng"},{"char":"为","pinyin":"wéi"},{"char":"异","pinyin":"yì"},{"char":"客","pinyin":"kè"},{"char":"，","pinyin":null}]},{"text":"每逢佳节倍思亲。","pinyin":"měi féng jiā jié bèi sī qīn","chars":[{"char":"每","pinyin":"měi"},{"char":"逢","pinyin":"féng"},{"char":"佳","pinyin":"jiā"},{"char":"节","pinyin":"jié"},{"char":"倍","pinyin":"bèi"},{"char":"思","pinyin":"sī"},{"char":"亲","pinyin":"qīn"},{"char":"。","pinyin":null}]},{"text":"遥知兄弟登高处，","pinyin":"yáo zhī xiōng dì dēng gāo chù","chars":[{"char":"遥","pinyin":"yáo"},{"char":"知","pinyin":"zhī"},{"char":"兄","pinyin":"xiōng"},{"char":"弟","pinyin":"dì"},{"char":"登","pinyin":"dēng"},{"char":"高","pinyin":"gāo"},{"char":"处","pinyin":"chù"},{"char":"，","pinyin":null}]},{"text":"遍插茱萸少一人","pinyin":"biàn chā zhū yú shǎo yí rén","chars":[{"char":"遍","pinyin":"biàn"},{"char":"插","pinyin":"chā"},{"char":"茱","pinyin":"zhū"},{"char":"萸","pinyin":"yú"},{"char":"少","pinyin":"shǎo"},{"char":"一","pinyin":"yí"},{"char":"人","pinyin":"rén"}]}],"titlePinyin":["jiǔ","yuè","jiǔ","rì","yì","shān","dōng","xiōng","dì"]}