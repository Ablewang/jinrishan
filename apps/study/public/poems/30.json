{"id":30,"title":"江畔独步寻花","dynasty":"唐","author":"杜甫","lines":[{"text":"黄四娘家花满蹊，","pinyin":"huáng sì niáng jiā huā mǎn xī","chars":[{"char":"黄","pinyin":"huáng"},{"char":"四","pinyin":"sì"},{"char":"娘","pinyin":"niáng"},{"char":"家","pinyin":"jiā"},{"char":"花","pinyin":"huā"},{"char":"满","pinyin":"mǎn"},{"char":"蹊","pinyin":"xī"},{"char":"，","pinyin":null}]},{"text":"千朵万朵压枝低。","pinyin":"qiān duǒ wàn duǒ yā zhī dī","chars":[{"char":"千","pinyin":"qiān"},{"char":"朵","pinyin":"duǒ"},{"char":"万","pinyin":"wàn"},{"char":"朵","pinyin":"duǒ"},{"char":"压","pinyin":"yā"},{"char":"枝","pinyin":"zhī"},{"char":"低","pinyin":"dī"},{"char":"。","pinyin":null}]},{"text":"留连戏蝶时时舞，","pinyin":"liú lián xì dié shí shí wǔ","chars":[{"char":"留","pinyin":"liú"},{"char":"连","pinyin":"lián"},{"char":"戏","pinyin":"xì"},{"char":"蝶","pinyin":"dié"},{"char":"时","pinyin":"shí"},{"char":"时","pinyin":"shí"},{"char":"舞","pinyin":"wǔ"},{"char":"，","pinyin":null}]},{"text":"自在娇莺恰恰啼。","pinyin":"zì zài jiāo yīng qià qià tí","chars":[{"char":"自","pinyin":"zì"},{"char":"在","pinyin":"zài"},{"char":"娇","pinyin":"jiāo"},{"char":"莺","pinyin":"yīng"},{"char":"恰","pinyin":"qià"},{"char":"恰","pinyin":"qià"},{"char":"啼","pinyin":"tí"},{"char":"。","pinyin":null}]}]}