{"id":60,"title":"秋夜将晓出篱门迎凉有感","dynasty":"宋","author":"陆游","lines":[{"text":"三万里河东入海，","pinyin":"sān wàn lǐ hé dōng rù hǎi","chars":[{"char":"三","pinyin":"sān"},{"char":"万","pinyin":"wàn"},{"char":"里","pinyin":"lǐ"},{"char":"河","pinyin":"hé"},{"char":"东","pinyin":"dōng"},{"char":"入","pinyin":"rù"},{"char":"海","pinyin":"hǎi"},{"char":"，","pinyin":null}]},{"text":"五千仞岳上摩天。","pinyin":"wǔ qiān rèn yuè shàng mó tiān","chars":[{"char":"五","pinyin":"wǔ"},{"char":"千","pinyin":"qiān"},{"char":"仞","pinyin":"rèn"},{"char":"岳","pinyin":"yuè"},{"char":"上","pinyin":"shàng"},{"char":"摩","pinyin":"mó"},{"char":"天","pinyin":"tiān"},{"char":"。","pinyin":null}]},{"text":"遗民泪尽胡尘里，","pinyin":"yí mín lèi jìn hú chén lǐ","chars":[{"char":"遗","pinyin":"yí"},{"char":"民","pinyin":"mín"},{"char":"泪","pinyin":"lèi"},{"char":"尽","pinyin":"jìn"},{"char":"胡","pinyin":"hú"},{"char":"尘","pinyin":"chén"},{"char":"里","pinyin":"lǐ"},{"char":"，","pinyin":null}]},{"text":"南望王师又一年。","pinyin":"nán wàng wáng shī yòu yì nián","chars":[{"char":"南","pinyin":"nán"},{"char":"望","pinyin":"wàng"},{"char":"王","pinyin":"wáng"},{"char":"师","pinyin":"shī"},{"char":"又","pinyin":"yòu"},{"char":"一","pinyin":"yì"},{"char":"年","pinyin":"nián"},{"char":"。","pinyin":null}]}],"titlePinyin":["qiū","yè","jiāng","xiǎo","chū","lí","mén","yíng","liáng","yǒu","gǎn"]}