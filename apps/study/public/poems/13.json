{"id":13,"title":"出塞","dynasty":"唐","author":"王昌龄","lines":[{"text":"秦时明月汉时关，","pinyin":"qín shí míng yuè hàn shí guān","chars":[{"char":"秦","pinyin":"qín"},{"char":"时","pinyin":"shí"},{"char":"明","pinyin":"míng"},{"char":"月","pinyin":"yuè"},{"char":"汉","pinyin":"hàn"},{"char":"时","pinyin":"shí"},{"char":"关","pinyin":"guān"},{"char":"，","pinyin":null}]},{"text":"万里长征人未还。","pinyin":"wàn lǐ cháng zhēng rén wèi huán","chars":[{"char":"万","pinyin":"wàn"},{"char":"里","pinyin":"lǐ"},{"char":"长","pinyin":"cháng"},{"char":"征","pinyin":"zhēng"},{"char":"人","pinyin":"rén"},{"char":"未","pinyin":"wèi"},{"char":"还","pinyin":"huán"},{"char":"。","pinyin":null}]},{"text":"但使龙城飞将在，","pinyin":"dàn shǐ lóng chéng fēi jiāng zài","chars":[{"char":"但","pinyin":"dàn"},{"char":"使","pinyin":"shǐ"},{"char":"龙","pinyin":"lóng"},{"char":"城","pinyin":"chéng"},{"char":"飞","pinyin":"fēi"},{"char":"将","pinyin":"jiāng"},{"char":"在","pinyin":"zài"},{"char":"，","pinyin":null}]},{"text":"不教胡马度阴山。","pinyin":"bù jiào hú mǎ dù yīn shān","chars":[{"char":"不","pinyin":"bù"},{"char":"教","pinyin":"jiào"},{"char":"胡","pinyin":"hú"},{"char":"马","pinyin":"mǎ"},{"char":"度","pinyin":"dù"},{"char":"阴","pinyin":"yīn"},{"char":"山","pinyin":"shān"},{"char":"。","pinyin":null}]}]}