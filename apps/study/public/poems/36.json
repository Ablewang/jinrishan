{"id":36,"title":"望洞庭","dynasty":"唐","author":"刘禹锡","lines":[{"text":"湖光秋月两相和，","pinyin":"hú guāng qiū yuè liǎng xiāng hé","chars":[{"char":"湖","pinyin":"hú"},{"char":"光","pinyin":"guāng"},{"char":"秋","pinyin":"qiū"},{"char":"月","pinyin":"yuè"},{"char":"两","pinyin":"liǎng"},{"char":"相","pinyin":"xiāng"},{"char":"和","pinyin":"hé"},{"char":"，","pinyin":null}]},{"text":"潭面无风镜未磨。","pinyin":"tán miàn wú fēng jìng wèi mó","chars":[{"char":"潭","pinyin":"tán"},{"char":"面","pinyin":"miàn"},{"char":"无","pinyin":"wú"},{"char":"风","pinyin":"fēng"},{"char":"镜","pinyin":"jìng"},{"char":"未","pinyin":"wèi"},{"char":"磨","pinyin":"mó"},{"char":"。","pinyin":null}]},{"text":"遥望洞庭山水翠，","pinyin":"yáo wàng dòng tíng shān shuǐ cuì","chars":[{"char":"遥","pinyin":"yáo"},{"char":"望","pinyin":"wàng"},{"char":"洞","pinyin":"dòng"},{"char":"庭","pinyin":"tíng"},{"char":"山","pinyin":"shān"},{"char":"水","pinyin":"shuǐ"},{"char":"翠","pinyin":"cuì"},{"char":"，","pinyin":null}]},{"text":"白银盘里一青螺。","pinyin":"bái yín pán lǐ yì qīng luó","chars":[{"char":"白","pinyin":"bái"},{"char":"银","pinyin":"yín"},{"char":"盘","pinyin":"pán"},{"char":"里","pinyin":"lǐ"},{"char":"一","pinyin":"yì"},{"char":"青","pinyin":"qīng"},{"char":"螺","pinyin":"luó"},{"char":"。","pinyin":null}]}],"titlePinyin":["wàng","dòng","tíng"]}