{"id":6,"title":"咏柳","dynasty":"唐","author":"贺知章","lines":[{"text":"碧玉妆成一树高，","pinyin":"bì yù zhuāng chéng yí shù gāo","chars":[{"char":"碧","pinyin":"bì"},{"char":"玉","pinyin":"yù"},{"char":"妆","pinyin":"zhuāng"},{"char":"成","pinyin":"chéng"},{"char":"一","pinyin":"yí"},{"char":"树","pinyin":"shù"},{"char":"高","pinyin":"gāo"},{"char":"，","pinyin":null}]},{"text":"万条垂下绿丝绦。","pinyin":"wàn tiáo chuí xià lǜ sī tāo","chars":[{"char":"万","pinyin":"wàn"},{"char":"条","pinyin":"tiáo"},{"char":"垂","pinyin":"chuí"},{"char":"下","pinyin":"xià"},{"char":"绿","pinyin":"lǜ"},{"char":"丝","pinyin":"sī"},{"char":"绦","pinyin":"tāo"},{"char":"。","pinyin":null}]},{"text":"不知细叶谁裁出，","pinyin":"bù zhī xì yè shuí cái chū","chars":[{"char":"不","pinyin":"bù"},{"char":"知","pinyin":"zhī"},{"char":"细","pinyin":"xì"},{"char":"叶","pinyin":"yè"},{"char":"谁","pinyin":"shuí"},{"char":"裁","pinyin":"cái"},{"char":"出","pinyin":"chū"},{"char":"，","pinyin":null}]},{"text":"二月春风似剪刀。","pinyin":"èr yuè chūn fēng sì jiǎn dāo","chars":[{"char":"二","pinyin":"èr"},{"char":"月","pinyin":"yuè"},{"char":"春","pinyin":"chūn"},{"char":"风","pinyin":"fēng"},{"char":"似","pinyin":"sì"},{"char":"剪","pinyin":"jiǎn"},{"char":"刀","pinyin":"dāo"},{"char":"。","pinyin":null}]}]}