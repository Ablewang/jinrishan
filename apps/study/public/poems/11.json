{"id":11,"title":"宿建德江","dynasty":"唐","author":"孟浩然","lines":[{"text":"移舟泊烟渚，","pinyin":"yí zhōu bó yān zhǔ","chars":[{"char":"移","pinyin":"yí"},{"char":"舟","pinyin":"zhōu"},{"char":"泊","pinyin":"bó"},{"char":"烟","pinyin":"yān"},{"char":"渚","pinyin":"zhǔ"},{"char":"，","pinyin":null}]},{"text":"日暮客愁新。","pinyin":"rì mù kè chóu xīn","chars":[{"char":"日","pinyin":"rì"},{"char":"暮","pinyin":"mù"},{"char":"客","pinyin":"kè"},{"char":"愁","pinyin":"chóu"},{"char":"新","pinyin":"xīn"},{"char":"。","pinyin":null}]},{"text":"野旷天低树，","pinyin":"yě kuàng tiān dī shù","chars":[{"char":"野","pinyin":"yě"},{"char":"旷","pinyin":"kuàng"},{"char":"天","pinyin":"tiān"},{"char":"低","pinyin":"dī"},{"char":"树","pinyin":"shù"},{"char":"，","pinyin":null}]},{"text":"江清月近人。","pinyin":"jiāng qīng yuè jìn rén","chars":[{"char":"江","pinyin":"jiāng"},{"char":"清","pinyin":"qīng"},{"char":"月","pinyin":"yuè"},{"char":"近","pinyin":"jìn"},{"char":"人","pinyin":"rén"},{"char":"。","pinyin":null}]}]}