{"id":68,"title":"乡村四月","dynasty":"宋","author":"翁卷","lines":[{"text":"绿遍山原白满川，","pinyin":"lǜ biàn shān yuán bái mǎn chuān","chars":[{"char":"绿","pinyin":"lǜ"},{"char":"遍","pinyin":"biàn"},{"char":"山","pinyin":"shān"},{"char":"原","pinyin":"yuán"},{"char":"白","pinyin":"bái"},{"char":"满","pinyin":"mǎn"},{"char":"川","pinyin":"chuān"},{"char":"，","pinyin":null}]},{"text":"子规声里雨如烟。","pinyin":"zǐ guī shēng lǐ yǔ rú yān","chars":[{"char":"子","pinyin":"zǐ"},{"char":"规","pinyin":"guī"},{"char":"声","pinyin":"shēng"},{"char":"里","pinyin":"lǐ"},{"char":"雨","pinyin":"yǔ"},{"char":"如","pinyin":"rú"},{"char":"烟","pinyin":"yān"},{"char":"。","pinyin":null}]},{"text":"乡村四月闲人少，","pinyin":"xiāng cūn sì yuè xián rén shǎo","chars":[{"char":"乡","pinyin":"xiāng"},{"char":"村","pinyin":"cūn"},{"char":"四","pinyin":"sì"},{"char":"月","pinyin":"yuè"},{"char":"闲","pinyin":"xián"},{"char":"人","pinyin":"rén"},{"char":"少","pinyin":"shǎo"},{"char":"，","pinyin":null}]},{"text":"才了蚕桑又插田。","pinyin":"cái liǎo cán sāng yòu chā tián","chars":[{"char":"才","pinyin":"cái"},{"char":"了","pinyin":"liǎo"},{"char":"蚕","pinyin":"cán"},{"char":"桑","pinyin":"sāng"},{"char":"又","pinyin":"yòu"},{"char":"插","pinyin":"chā"},{"char":"田","pinyin":"tián"},{"char":"。","pinyin":null}]}],"titlePinyin":["xiāng","cūn","sì","yuè"]}