{"id":23,"title":"黄鹤楼送孟浩然之广陵","dynasty":"唐","author":"李白","lines":[{"text":"故人西辞黄鹤楼，","pinyin":"gù rén xī cí huáng hè lóu","chars":[{"char":"故","pinyin":"gù"},{"char":"人","pinyin":"rén"},{"char":"西","pinyin":"xī"},{"char":"辞","pinyin":"cí"},{"char":"黄","pinyin":"huáng"},{"char":"鹤","pinyin":"hè"},{"char":"楼","pinyin":"lóu"},{"char":"，","pinyin":null}]},{"text":"烟花三月下扬州。","pinyin":"yān huā sān yuè xià yáng zhōu","chars":[{"char":"烟","pinyin":"yān"},{"char":"花","pinyin":"huā"},{"char":"三","pinyin":"sān"},{"char":"月","pinyin":"yuè"},{"char":"下","pinyin":"xià"},{"char":"扬","pinyin":"yáng"},{"char":"州","pinyin":"zhōu"},{"char":"。","pinyin":null}]},{"text":"孤帆远影碧空尽，","pinyin":"gū fān yuǎn yǐng bì kōng jìn","chars":[{"char":"孤","pinyin":"gū"},{"char":"帆","pinyin":"fān"},{"char":"远","pinyin":"yuǎn"},{"char":"影","pinyin":"yǐng"},{"char":"碧","pinyin":"bì"},{"char":"空","pinyin":"kōng"},{"char":"尽","pinyin":"jìn"},{"char":"，","pinyin":null}]},{"text":"唯见长江天际流。","pinyin":"wéi jiàn cháng jiāng tiān jì liú","chars":[{"char":"唯","pinyin":"wéi"},{"char":"见","pinyin":"jiàn"},{"char":"长","pinyin":"cháng"},{"char":"江","pinyin":"jiāng"},{"char":"天","pinyin":"tiān"},{"char":"际","pinyin":"jì"},{"char":"流","pinyin":"liú"},{"char":"。","pinyin":null}]}]}