{"id":1,"title":"江南","dynasty":null,"author":"汉乐府","lines":[{"text":"江南可采莲，","pinyin":"jiāng nán kě cǎi lián","chars":[{"char":"江","pinyin":"jiāng"},{"char":"南","pinyin":"nán"},{"char":"可","pinyin":"kě"},{"char":"采","pinyin":"cǎi"},{"char":"莲","pinyin":"lián"},{"char":"，","pinyin":null}]},{"text":"莲叶何田田。","pinyin":"lián yè hé tián tián","chars":[{"char":"莲","pinyin":"lián"},{"char":"叶","pinyin":"yè"},{"char":"何","pinyin":"hé"},{"char":"田","pinyin":"tián"},{"char":"田","pinyin":"tián"},{"char":"。","pinyin":null}]},{"text":"鱼戏莲叶间。","pinyin":"yú xì lián yè jiān","chars":[{"char":"鱼","pinyin":"yú"},{"char":"戏","pinyin":"xì"},{"char":"莲","pinyin":"lián"},{"char":"叶","pinyin":"yè"},{"char":"间","pinyin":"jiān"},{"char":"。","pinyin":null}]},{"text":"鱼戏莲叶东，","pinyin":"yú xì lián yè dōng","chars":[{"char":"鱼","pinyin":"yú"},{"char":"戏","pinyin":"xì"},{"char":"莲","pinyin":"lián"},{"char":"叶","pinyin":"yè"},{"char":"东","pinyin":"dōng"},{"char":"，","pinyin":null}]},{"text":"鱼戏莲叶西，","pinyin":"yú xì lián yè xī","chars":[{"char":"鱼","pinyin":"yú"},{"char":"戏","pinyin":"xì"},{"char":"莲","pinyin":"lián"},{"char":"叶","pinyin":"yè"},{"char":"西","pinyin":"xī"},{"char":"，","pinyin":null}]},{"text":"鱼戏莲叶南，","pinyin":"yú xì lián yè nán","chars":[{"char":"鱼","pinyin":"yú"},{"char":"戏","pinyin":"xì"},{"char":"莲","pinyin":"lián"},{"char":"叶","pinyin":"yè"},{"char":"南","pinyin":"nán"},{"char":"，","pinyin":null}]},{"text":"鱼戏莲叶北。","pinyin":"yú xì lián yè běi","chars":[{"char":"鱼","pinyin":"yú"},{"char":"戏","pinyin":"xì"},{"char":"莲","pinyin":"lián"},{"char":"叶","pinyin":"yè"},{"char":"北","pinyin":"běi"},{"char":"。","pinyin":null}]}],"titlePinyin":["jiāng","nán"]}