{"id":65,"title":"春日","dynasty":"宋","author":"朱熹","lines":[{"text":"胜日寻芳泗水滨，","pinyin":"shèng rì xún fāng sì shuǐ bīn","chars":[{"char":"胜","pinyin":"shèng"},{"char":"日","pinyin":"rì"},{"char":"寻","pinyin":"xún"},{"char":"芳","pinyin":"fāng"},{"char":"泗","pinyin":"sì"},{"char":"水","pinyin":"shuǐ"},{"char":"滨","pinyin":"bīn"},{"char":"，","pinyin":null}]},{"text":"无边光景一时新。","pinyin":"wú biān guāng jǐng yì shí xīn","chars":[{"char":"无","pinyin":"wú"},{"char":"边","pinyin":"biān"},{"char":"光","pinyin":"guāng"},{"char":"景","pinyin":"jǐng"},{"char":"一","pinyin":"yì"},{"char":"时","pinyin":"shí"},{"char":"新","pinyin":"xīn"},{"char":"。","pinyin":null}]},{"text":"等闲识得东风面，","pinyin":"děng xián shí dé dōng fēng miàn","chars":[{"char":"等","pinyin":"děng"},{"char":"闲","pinyin":"xián"},{"char":"识","pinyin":"shí"},{"char":"得","pinyin":"dé"},{"char":"东","pinyin":"dōng"},{"char":"风","pinyin":"fēng"},{"char":"面","pinyin":"miàn"},{"char":"，","pinyin":null}]},{"text":"万紫千红总是春。","pinyin":"wàn zǐ qiān hóng zǒng shì chūn","chars":[{"char":"万","pinyin":"wàn"},{"char":"紫","pinyin":"zǐ"},{"char":"千","pinyin":"qiān"},{"char":"红","pinyin":"hóng"},{"char":"总","pinyin":"zǒng"},{"char":"是","pinyin":"shì"},{"char":"春","pinyin":"chūn"},{"char":"。","pinyin":null}]}]}