{"id":29,"title":"绝句","dynasty":"唐","author":"杜甫","lines":[{"text":"迟日江山丽，","pinyin":"chí rì jiāng shān lì","chars":[{"char":"迟","pinyin":"chí"},{"char":"日","pinyin":"rì"},{"char":"江","pinyin":"jiāng"},{"char":"山","pinyin":"shān"},{"char":"丽","pinyin":"lì"},{"char":"，","pinyin":null}]},{"text":"春风花草香。","pinyin":"chūn fēng huā cǎo xiāng","chars":[{"char":"春","pinyin":"chūn"},{"char":"风","pinyin":"fēng"},{"char":"花","pinyin":"huā"},{"char":"草","pinyin":"cǎo"},{"char":"香","pinyin":"xiāng"},{"char":"。","pinyin":null}]},{"text":"泥融飞燕子，","pinyin":"ní róng fēi yàn zǐ","chars":[{"char":"泥","pinyin":"ní"},{"char":"融","pinyin":"róng"},{"char":"飞","pinyin":"fēi"},{"char":"燕","pinyin":"yàn"},{"char":"子","pinyin":"zǐ"},{"char":"，","pinyin":null}]},{"text":"沙暖睡鸳鸯。","pinyin":"shā nuǎn shuì yuān yāng","chars":[{"char":"沙","pinyin":"shā"},{"char":"暖","pinyin":"nuǎn"},{"char":"睡","pinyin":"shuì"},{"char":"鸳","pinyin":"yuān"},{"char":"鸯","pinyin":"yāng"},{"char":"。","pinyin":null}]}]}