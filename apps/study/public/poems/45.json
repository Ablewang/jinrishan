{"id":45,"title":"山行","dynasty":"唐","author":"杜牧","lines":[{"text":"远上寒山石径斜，","pinyin":"yuǎn shàng hán shān shí jìng xié","chars":[{"char":"远","pinyin":"yuǎn"},{"char":"上","pinyin":"shàng"},{"char":"寒","pinyin":"hán"},{"char":"山","pinyin":"shān"},{"char":"石","pinyin":"shí"},{"char":"径","pinyin":"jìng"},{"char":"斜","pinyin":"xié"},{"char":"，","pinyin":null}]},{"text":"白云生处有人家。","pinyin":"bái yún shēng chù yǒu rén jiā","chars":[{"char":"白","pinyin":"bái"},{"char":"云","pinyin":"yún"},{"char":"生","pinyin":"shēng"},{"char":"处","pinyin":"chù"},{"char":"有","pinyin":"yǒu"},{"char":"人","pinyin":"rén"},{"char":"家","pinyin":"jiā"},{"char":"。","pinyin":null}]},{"text":"停车坐爱枫林晚，","pinyin":"tíng chē zuò ài fēng lín wǎn","chars":[{"char":"停","pinyin":"tíng"},{"char":"车","pinyin":"chē"},{"char":"坐","pinyin":"zuò"},{"char":"爱","pinyin":"ài"},{"char":"枫","pinyin":"fēng"},{"char":"林","pinyin":"lín"},{"char":"晚","pinyin":"wǎn"},{"char":"，","pinyin":null}]},{"text":"霜叶红于二月花。","pinyin":"shuāng yè hóng yú èr yuè huā","chars":[{"char":"霜","pinyin":"shuāng"},{"char":"叶","pinyin":"yè"},{"char":"红","pinyin":"hóng"},{"char":"于","pinyin":"yú"},{"char":"二","pinyin":"èr"},{"char":"月","pinyin":"yuè"},{"char":"花","pinyin":"huā"},{"char":"。","pinyin":null}]}],"titlePinyin":["shān","xíng"]}