{"id":24,"title":"早发白帝城","dynasty":"唐","author":"李白","lines":[{"text":"朝辞白帝彩云间，","pinyin":"zhāo cí bái dì cǎi yún jiān","chars":[{"char":"朝","pinyin":"zhāo"},{"char":"辞","pinyin":"cí"},{"char":"白","pinyin":"bái"},{"char":"帝","pinyin":"dì"},{"char":"彩","pinyin":"cǎi"},{"char":"云","pinyin":"yún"},{"char":"间","pinyin":"jiān"},{"char":"，","pinyin":null}]},{"text":"千里江陵一日还。","pinyin":"qiān lǐ jiāng líng yí rì huán","chars":[{"char":"千","pinyin":"qiān"},{"char":"里","pinyin":"lǐ"},{"char":"江","pinyin":"jiāng"},{"char":"陵","pinyin":"líng"},{"char":"一","pinyin":"yí"},{"char":"日","pinyin":"rì"},{"char":"还","pinyin":"huán"},{"char":"。","pinyin":null}]},{"text":"两岸猿声啼不住，","pinyin":"liǎng àn yuán shēng tí bù zhù","chars":[{"char":"两","pinyin":"liǎng"},{"char":"岸","pinyin":"àn"},{"char":"猿","pinyin":"yuán"},{"char":"声","pinyin":"shēng"},{"char":"啼","pinyin":"tí"},{"char":"不","pinyin":"bù"},{"char":"住","pinyin":"zhù"},{"char":"，","pinyin":null}]},{"text":"轻舟已过万重山。","pinyin":"qīng zhōu yǐ guò wàn chóng shān","chars":[{"char":"轻","pinyin":"qīng"},{"char":"舟","pinyin":"zhōu"},{"char":"已","pinyin":"yǐ"},{"char":"过","pinyin":"guò"},{"char":"万","pinyin":"wàn"},{"char":"重","pinyin":"chóng"},{"char":"山","pinyin":"shān"},{"char":"。","pinyin":null}]}]}