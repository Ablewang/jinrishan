{"id":47,"title":"江南春","dynasty":"唐","author":"杜牧","lines":[{"text":"千里莺啼绿映红，","pinyin":"qiān lǐ yīng tí lǜ yìng hóng","chars":[{"char":"千","pinyin":"qiān"},{"char":"里","pinyin":"lǐ"},{"char":"莺","pinyin":"yīng"},{"char":"啼","pinyin":"tí"},{"char":"绿","pinyin":"lǜ"},{"char":"映","pinyin":"yìng"},{"char":"红","pinyin":"hóng"},{"char":"，","pinyin":null}]},{"text":"水村山郭酒旗风。","pinyin":"shuǐ cūn shān guō jiǔ qí fēng","chars":[{"char":"水","pinyin":"shuǐ"},{"char":"村","pinyin":"cūn"},{"char":"山","pinyin":"shān"},{"char":"郭","pinyin":"guō"},{"char":"酒","pinyin":"jiǔ"},{"char":"旗","pinyin":"qí"},{"char":"风","pinyin":"fēng"},{"char":"。","pinyin":null}]},{"text":"南朝四百八十寺，","pinyin":"nán cháo sì bǎi bā shí sì","chars":[{"char":"南","pinyin":"nán"},{"char":"朝","pinyin":"cháo"},{"char":"四","pinyin":"sì"},{"char":"百","pinyin":"bǎi"},{"char":"八","pinyin":"bā"},{"char":"十","pinyin":"shí"},{"char":"寺","pinyin":"sì"},{"char":"，","pinyin":null}]},{"text":"多少楼台烟雨中。","pinyin":"duō shǎo lóu tái yān yǔ zhōng","chars":[{"char":"多","pinyin":"duō"},{"char":"少","pinyin":"shǎo"},{"char":"楼","pinyin":"lóu"},{"char":"台","pinyin":"tái"},{"char":"烟","pinyin":"yān"},{"char":"雨","pinyin":"yǔ"},{"char":"中","pinyin":"zhōng"},{"char":"。","pinyin":null}]}],"titlePinyin":["jiāng","nán","chūn"]}