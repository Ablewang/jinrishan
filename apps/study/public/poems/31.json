{"id":31,"title":"枫桥夜泊","dynasty":"唐","author":"张继","lines":[{"text":"月落乌啼霜满天，","pinyin":"yuè luò wū tí shuāng mǎn tiān","chars":[{"char":"月","pinyin":"yuè"},{"char":"落","pinyin":"luò"},{"char":"乌","pinyin":"wū"},{"char":"啼","pinyin":"tí"},{"char":"霜","pinyin":"shuāng"},{"char":"满","pinyin":"mǎn"},{"char":"天","pinyin":"tiān"},{"char":"，","pinyin":null}]},{"text":"江枫渔火对愁眠。","pinyin":"jiāng fēng yú huǒ duì chóu mián","chars":[{"char":"江","pinyin":"jiāng"},{"char":"枫","pinyin":"fēng"},{"char":"渔","pinyin":"yú"},{"char":"火","pinyin":"huǒ"},{"char":"对","pinyin":"duì"},{"char":"愁","pinyin":"chóu"},{"char":"眠","pinyin":"mián"},{"char":"。","pinyin":null}]},{"text":"姑苏城外寒山寺，","pinyin":"gū sū chéng wài hán shān sì","chars":[{"char":"姑","pinyin":"gū"},{"char":"苏","pinyin":"sū"},{"char":"城","pinyin":"chéng"},{"char":"外","pinyin":"wài"},{"char":"寒","pinyin":"hán"},{"char":"山","pinyin":"shān"},{"char":"寺","pinyin":"sì"},{"char":"，","pinyin":null}]},{"text":"夜半钟声到客船。","pinyin":"yè bàn zhōng shēng dào kè chuán","chars":[{"char":"夜","pinyin":"yè"},{"char":"半","pinyin":"bàn"},{"char":"钟","pinyin":"zhōng"},{"char":"声","pinyin":"shēng"},{"char":"到","pinyin":"dào"},{"char":"客","pinyin":"kè"},{"char":"船","pinyin":"chuán"},{"char":"。","pinyin":null}]}]}