{"id":51,"title":"元日","dynasty":"宋","author":"王安石","lines":[{"text":"爆竹声中一岁除，","pinyin":"bào zhú shēng zhōng yí suì chú","chars":[{"char":"爆","pinyin":"bào"},{"char":"竹","pinyin":"zhú"},{"char":"声","pinyin":"shēng"},{"char":"中","pinyin":"zhōng"},{"char":"一","pinyin":"yí"},{"char":"岁","pinyin":"suì"},{"char":"除","pinyin":"chú"},{"char":"，","pinyin":null}]},{"text":"春风送暖入屠苏。","pinyin":"chūn fēng sòng nuǎn rù tú sū","chars":[{"char":"春","pinyin":"chūn"},{"char":"风","pinyin":"fēng"},{"char":"送","pinyin":"sòng"},{"char":"暖","pinyin":"nuǎn"},{"char":"入","pinyin":"rù"},{"char":"屠","pinyin":"tú"},{"char":"苏","pinyin":"sū"},{"char":"。","pinyin":null}]},{"text":"千门万户瞳瞳日，","pinyin":"qiān mén wàn hù tóng tóng rì","chars":[{"char":"千","pinyin":"qiān"},{"char":"门","pinyin":"mén"},{"char":"万","pinyin":"wàn"},{"char":"户","pinyin":"hù"},{"char":"瞳","pinyin":"tóng"},{"char":"瞳","pinyin":"tóng"},{"char":"日","pinyin":"rì"},{"char":"，","pinyin":null}]},{"text":"总把新桃换旧符。","pinyin":"zǒng bǎ xīn táo huàn jiù fú","chars":[{"char":"总","pinyin":"zǒng"},{"char":"把","pinyin":"bǎ"},{"char":"新","pinyin":"xīn"},{"char":"桃","pinyin":"táo"},{"char":"换","pinyin":"huàn"},{"char":"旧","pinyin":"jiù"},{"char":"符","pinyin":"fú"},{"char":"。","pinyin":null}]}],"titlePinyin":["yuán","rì"]}