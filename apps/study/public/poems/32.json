{"id":32,"title":"游子吟","dynasty":"唐","author":"孟郊","lines":[{"text":"慈母手中线，","pinyin":"cí mǔ shǒu zhōng xiàn","chars":[{"char":"慈","pinyin":"cí"},{"char":"母","pinyin":"mǔ"},{"char":"手","pinyin":"shǒu"},{"char":"中","pinyin":"zhōng"},{"char":"线","pinyin":"xiàn"},{"char":"，","pinyin":null}]},{"text":"游子身上衣。","pinyin":"yóu zǐ shēn shàng yī","chars":[{"char":"游","pinyin":"yóu"},{"char":"子","pinyin":"zǐ"},{"char":"身","pinyin":"shēn"},{"char":"上","pinyin":"shàng"},{"char":"衣","pinyin":"yī"},{"char":"。","pinyin":null}]},{"text":"临行密密缝，","pinyin":"lín xíng mì mì féng","chars":[{"char":"临","pinyin":"lín"},{"char":"行","pinyin":"xíng"},{"char":"密","pinyin":"mì"},{"char":"密","pinyin":"mì"},{"char":"缝","pinyin":"féng"},{"char":"，","pinyin":null}]},{"text":"意恐迟迟归。","pinyin":"yì kǒng chí chí guī","chars":[{"char":"意","pinyin":"yì"},{"char":"恐","pinyin":"kǒng"},{"char":"迟","pinyin":"chí"},{"char":"迟","pinyin":"chí"},{"char":"归","pinyin":"guī"},{"char":"。","pinyin":null}]},{"text":"谁言寸草心，","pinyin":"shuí yán cùn cǎo xīn","chars":[{"char":"谁","pinyin":"shuí"},{"char":"言","pinyin":"yán"},{"char":"寸","pinyin":"cùn"},{"char":"草","pinyin":"cǎo"},{"char":"心","pinyin":"xīn"},{"char":"，","pinyin":null}]},{"text":"报得三春晖。","pinyin":"bào dé sān chūn huī","chars":[{"char":"报","pinyin":"bào"},{"char":"得","pinyin":"dé"},{"char":"三","pinyin":"sān"},{"char":"春","pinyin":"chūn"},{"char":"晖","pinyin":"huī"},{"char":"。","pinyin":null}]}]}