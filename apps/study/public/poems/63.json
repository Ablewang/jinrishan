{"id":63,"title":"小池","dynasty":"宋","author":"杨万里","lines":[{"text":"泉眼无声惜细流，","pinyin":"quán yǎn wú shēng xī xì liú","chars":[{"char":"泉","pinyin":"quán"},{"char":"眼","pinyin":"yǎn"},{"char":"无","pinyin":"wú"},{"char":"声","pinyin":"shēng"},{"char":"惜","pinyin":"xī"},{"char":"细","pinyin":"xì"},{"char":"流","pinyin":"liú"},{"char":"，","pinyin":null}]},{"text":"树阴照水爱晴柔。","pinyin":"shù yīn zhào shuǐ ài qíng róu","chars":[{"char":"树","pinyin":"shù"},{"char":"阴","pinyin":"yīn"},{"char":"照","pinyin":"zhào"},{"char":"水","pinyin":"shuǐ"},{"char":"爱","pinyin":"ài"},{"char":"晴","pinyin":"qíng"},{"char":"柔","pinyin":"róu"},{"char":"。","pinyin":null}]},{"text":"小荷才露尖尖角，","pinyin":"xiǎo hé cái lù jiān jiān jiǎo","chars":[{"char":"小","pinyin":"xiǎo"},{"char":"荷","pinyin":"hé"},{"char":"才","pinyin":"cái"},{"char":"露","pinyin":"lù"},{"char":"尖","pinyin":"jiān"},{"char":"尖","pinyin":"jiān"},{"char":"角","pinyin":"jiǎo"},{"char":"，","pinyin":null}]},{"text":"早有蜻蜓立上头。","pinyin":"zǎo yǒu qīng tíng lì shàng tóu","chars":[{"char":"早","pinyin":"zǎo"},{"char":"有","pinyin":"yǒu"},{"char":"蜻","pinyin":"qīng"},{"char":"蜓","pinyin":"tíng"},{"char":"立","pinyin":"lì"},{"char":"上","pinyin":"shàng"},{"char":"头","pinyin":"tóu"},{"char":"。","pinyin":null}]}],"titlePinyin":["xiǎo","chí"]}