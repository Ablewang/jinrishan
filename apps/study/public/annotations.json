{
  "poems": [
    {
      "id": 1,
      "title": "江南",
      "notes": [
        {
          "word": "田田",
          "meaning": "荷叶圆润茂盛的样子"
        },
        {
          "word": "可",
          "meaning": "适宜、正好"
        },
        {
          "word": "戏",
          "meaning": "游戏、嬉戏"
        }
      ],
      "translation": "江南是采莲的好地方，莲叶层层叠叠，迎风摇曳。欢快的鱼儿在茂密的荷叶下嬉戏玩耍，一会儿游到东边，一会儿游到西边，来来往往。"
    },
    {
      "id": 2,
      "title": "长歌行",
      "notes": [
        {
          "word": "晞",
          "meaning": "被阳光照耀而干"
        },
        {
          "word": "阳春",
          "meaning": "温暖的春天"
        },
        {
          "word": "德泽",
          "meaning": "恩惠"
        },
        {
          "word": "焜黄",
          "meaning": "草木凋落枯黄的样子"
        },
        {
          "word": "百川",
          "meaning": "江河湖泽的总称"
        },
        {
          "word": "少壮",
          "meaning": "年轻力壮"
        },
        {
          "word": "老大",
          "meaning": "年老了"
        },
        {
          "word": "徒",
          "meaning": "白白地"
        }
      ],
      "translation": "园中葵菜郁郁葱葱，晶莹朝露等待阳光。春天给大地普施阳光雨露，万物欣欣向荣。常恐那肃杀的秋天来到，树叶黄落百草凋零。百川奔腾向东流入大海，何时才能返回？年轻时不奋发图强，到老来悲伤也没用了。"
    },
    {
      "id": 3,
      "title": "敕勒歌",
      "notes": [
        {
          "word": "敕勒川",
          "meaning": "敕勒族居住的平原，在今山西、内蒙一带"
        },
        {
          "word": "阴山",
          "meaning": "内蒙古北部的大山"
        },
        {
          "word": "穹庐",
          "meaning": "毡布搭成的帐篷，即蒙古包"
        },
        {
          "word": "笼盖四野",
          "meaning": "笼罩草原的四面八方"
        },
        {
          "word": "苍苍",
          "meaning": "青色"
        },
        {
          "word": "茫茫",
          "meaning": "辽阔无边的样子"
        },
        {
          "word": "见",
          "meaning": "同\"现\"，显露"
        }
      ],
      "translation": "辽阔的敕勒平原就在阴山脚下。天空如同毡制的圆顶帐篷，笼罩着草原四面八方。天空青苍蔚蓝，草原辽阔无边。风吹过时，牧草低伏，隐没在草丛中的牛羊显露出来。"
    },
    {
      "id": 4,
      "title": "咏鹅",
      "notes": [
        {
          "word": "曲项",
          "meaning": "弯着脖子"
        },
        {
          "word": "歌",
          "meaning": "长鸣"
        },
        {
          "word": "拨",
          "meaning": "划动"
        }
      ],
      "translation": "鹅鹅鹅，一群鹅儿面向蓝天，伸着弯曲的脖子在歌唱。白色的身体漂浮在碧绿的水面上，红红的脚掌拨动着清清水波。"
    },
    {
      "id": 5,
      "title": "风",
      "notes": [
        {
          "word": "解落",
          "meaning": "吹落"
        },
        {
          "word": "三秋",
          "meaning": "秋季"
        },
        {
          "word": "二月",
          "meaning": "农历二月，指春季"
        },
        {
          "word": "过",
          "meaning": "经过"
        },
        {
          "word": "斜",
          "meaning": "倾斜"
        }
      ],
      "translation": "风能吹落秋天的树叶，也能吹开春天美丽的花。风刮过江面能掀起千尺巨浪，吹进竹林又能使万棵竹子倾斜。"
    },
    {
      "id": 6,
      "title": "咏柳",
      "notes": [
        {
          "word": "碧玉",
          "meaning": "碧绿色的玉，比喻嫩绿的柳叶"
        },
        {
          "word": "妆",
          "meaning": "装饰、打扮"
        },
        {
          "word": "绿丝绦",
          "meaning": "绿色的丝带，形容柳条柔软下垂"
        },
        {
          "word": "裁",
          "meaning": "裁剪"
        }
      ],
      "translation": "柳树高耸如碧玉妆成，千万条细长柳枝轻轻垂下，仿佛绿色丝带飘动。这精致的柳叶是谁裁剪出来的？原来是二月的春风，就像一把灵巧的剪刀。"
    },
    {
      "id": 7,
      "title": "回乡偶书",
      "notes": [
        {
          "word": "偶书",
          "meaning": "偶然写下"
        },
        {
          "word": "乡音",
          "meaning": "家乡的口音"
        },
        {
          "word": "无改",
          "meaning": "没有改变"
        },
        {
          "word": "鬓毛衰",
          "meaning": "鬓角的头发已经斑白稀少"
        },
        {
          "word": "相逢",
          "meaning": "相遇"
        }
      ],
      "translation": "我年少时离开家乡，到老了才回来。家乡的口音没有变，但鬓角的头发已经斑白了。孩子们看见我却不认识，笑着问我是从哪里来的客人。"
    },
    {
      "id": 8,
      "title": "凉州词",
      "notes": [
        {
          "word": "夜光杯",
          "meaning": "玉石制成的酒杯，月光下会闪光"
        },
        {
          "word": "欲",
          "meaning": "将要"
        },
        {
          "word": "琵琶",
          "meaning": "这里指战场上的乐器声"
        },
        {
          "word": "催",
          "meaning": "催人出征"
        },
        {
          "word": "沙场",
          "meaning": "战场"
        },
        {
          "word": "征战",
          "meaning": "打仗"
        }
      ],
      "translation": "酒席上用玉杯盛满葡萄美酒，正要开怀畅饮时，琵琶声响起助兴。即便醉倒在沙场上也不要嘲笑我，自古以来出征打仗能活着回来的有几个人？"
    },
    {
      "id": 9,
      "title": "登鹳雀楼",
      "notes": [
        {
          "word": "白日",
          "meaning": "太阳"
        },
        {
          "word": "依",
          "meaning": "依傍"
        },
        {
          "word": "尽",
          "meaning": "消失"
        },
        {
          "word": "欲",
          "meaning": "想要"
        },
        {
          "word": "穷",
          "meaning": "尽，看到尽头"
        },
        {
          "word": "更",
          "meaning": "再"
        }
      ],
      "translation": "夕阳依着山峦慢慢沉落，黄河水奔腾流向大海。想要看遍千里之外的风景，就要再往上攀登一层楼。"
    },
    {
      "id": 10,
      "title": "春晓",
      "notes": [
        {
          "word": "晓",
          "meaning": "天刚亮的时候"
        },
        {
          "word": "不觉晓",
          "meaning": "不知不觉天就亮了"
        },
        {
          "word": "啼鸟",
          "meaning": "鸟的啼叫声"
        },
        {
          "word": "知多少",
          "meaning": "不知有多少"
        }
      ],
      "translation": "春日里睡得香甜，不知不觉天已亮了。到处都能听到鸟儿欢快地叫。回想昨夜听到的阵阵风雨声，现在不知有多少美丽的春花被吹落了。"
    },
    {
      "id": 11,
      "title": "宿建德江",
      "notes": [
        {
          "word": "移舟",
          "meaning": "划动小船"
        },
        {
          "word": "泊",
          "meaning": "停船靠岸"
        },
        {
          "word": "烟渚",
          "meaning": "雾气笼罩的小沙洲"
        },
        {
          "word": "旷",
          "meaning": "空阔远大"
        },
        {
          "word": "天低树",
          "meaning": "天幕低垂，似与树木相连"
        },
        {
          "word": "月近人",
          "meaning": "月亮倒映水中，显得贴近人"
        }
      ],
      "translation": "将小船靠岸停在雾气笼罩的沙洲旁，傍晚时新的乡愁涌上心头。原野辽阔，远处天空比近处树林还低；江水清澈，明月的倒影仿佛更靠近船上的人。"
    },
    {
      "id": 12,
      "title": "凉州词",
      "notes": [
        {
          "word": "远上",
          "meaning": "远远向西望去"
        },
        {
          "word": "孤城",
          "meaning": "孤零零的戍边城堡"
        },
        {
          "word": "仞",
          "meaning": "古代长度单位，约七八尺"
        },
        {
          "word": "羌笛",
          "meaning": "羌族乐器"
        },
        {
          "word": "何须",
          "meaning": "何必"
        },
        {
          "word": "杨柳",
          "meaning": "指《杨柳曲》，代指送别"
        },
        {
          "word": "玉门关",
          "meaning": "古代通往西域的要道"
        }
      ],
      "translation": "黄河远远向西流去，好像从白云间奔腾而来；玉门关孤独地矗立在高山之中。何必用羌笛吹奏哀伤的《杨柳曲》来埋怨春光迟迟不至？玉门关一带根本吹不到春风。"
    },
    {
      "id": 13,
      "title": "出塞",
      "notes": [
        {
          "word": "但使",
          "meaning": "只要"
        },
        {
          "word": "龙城飞将",
          "meaning": "指汉代名将李广"
        },
        {
          "word": "教",
          "meaning": "令，使"
        },
        {
          "word": "胡马",
          "meaning": "指侵扰内地的外族骑兵"
        },
        {
          "word": "度",
          "meaning": "越过"
        },
        {
          "word": "阴山",
          "meaning": "内蒙古中部及河北北部的山"
        }
      ],
      "translation": "依旧是秦汉时的明月和边关，守边御敌鏖战万里征夫未回还。只要龙城飞将李广如今还在，一定不会让敌人的铁蹄踏过阴山。"
    },
    {
      "id": 14,
      "title": "芙蓉楼送辛渐",
      "notes": [
        {
          "word": "芙蓉楼",
          "meaning": "在今江苏镇江，可俯瞰长江"
        },
        {
          "word": "寒雨",
          "meaning": "秋冬时节的冷雨"
        },
        {
          "word": "连江",
          "meaning": "雨水与江面连成一片"
        },
        {
          "word": "平明",
          "meaning": "天刚亮的时候"
        },
        {
          "word": "冰心",
          "meaning": "比喻纯洁的心"
        },
        {
          "word": "玉壶",
          "meaning": "比喻纯正高洁的品格"
        }
      ],
      "translation": "寒冷的雨夜连江而下，笼罩吴地。清晨送别友人，独自面对楚山，离愁万千。若洛阳亲友询问我的近况，请转告他们：我的心如同玉壶中的冰，依然晶莹纯洁。"
    },
    {
      "id": 15,
      "title": "鹿柴",
      "notes": [
        {
          "word": "鹿柴",
          "meaning": "王维在辋川别业的胜景之一，柴通\"寨\""
        },
        {
          "word": "但",
          "meaning": "只"
        },
        {
          "word": "返景",
          "meaning": "日光，指夕阳通过云彩反射的阳光"
        },
        {
          "word": "复",
          "meaning": "又"
        }
      ],
      "translation": "幽静的山谷里看不见人，只能听到说话的声音。落日余光映入深林，又照在幽暗处的青苔上。"
    },
    {
      "id": 16,
      "title": "竹里馆",
      "notes": [
        {
          "word": "幽篁",
          "meaning": "幽深的竹林"
        },
        {
          "word": "啸",
          "meaning": "拉长声音呼叫"
        },
        {
          "word": "深林",
          "meaning": "深密的树林"
        },
        {
          "word": "相照",
          "meaning": "互相映照"
        }
      ],
      "translation": "独自坐在幽深的竹林里，边弹琴边长啸。竹林深处没有人知道，只有明月前来相伴照耀。"
    },
    {
      "id": 17,
      "title": "送元二使安西",
      "notes": [
        {
          "word": "安西",
          "meaning": "唐代安西都护府"
        },
        {
          "word": "渭城",
          "meaning": "今陕西省西安市西北"
        },
        {
          "word": "浥",
          "meaning": "润湿"
        },
        {
          "word": "客舍",
          "meaning": "旅馆"
        },
        {
          "word": "柳色",
          "meaning": "柳树，象征离别"
        },
        {
          "word": "阳关",
          "meaning": "今甘肃省敦煌西南，古代前往西北的要道"
        }
      ],
      "translation": "清晨，渭城被春雨洗润，尘埃清爽。旅舍旁的柳树在春天里格外青翠。朋友，请再喝一杯酒吧。一旦向西穿过阳关，就很难再遇见故旧了。"
    },
    {
      "id": 18,
      "title": "九月九日忆山东兄弟",
      "notes": [
        {
          "word": "异乡",
          "meaning": "他乡"
        },
        {
          "word": "为异客",
          "meaning": "作客他乡"
        },
        {
          "word": "佳节",
          "meaning": "节日，这里指重阳节"
        },
        {
          "word": "登高",
          "meaning": "重阳节登高的习俗"
        },
        {
          "word": "茱萸",
          "meaning": "一种植物，重阳节时人们会佩戴"
        }
      ],
      "translation": "独自在他乡作客，每逢佳节倍加思念家乡的亲人。遥想兄弟们今日登高望远，身上都插着茱萸，却少了我一人。"
    },
    {
      "id": 19,
      "title": "静夜思",
      "notes": [
        {
          "word": "疑",
          "meaning": "好像、仿佛"
        },
        {
          "word": "举头",
          "meaning": "抬起头"
        },
        {
          "word": "霜",
          "meaning": "这里形容月光皎洁如霜"
        }
      ],
      "translation": "明亮的月光洒在床前，看起来好像地面上铺了一层白霜。诗人抬起头来望着天空中的明月，不禁低下头思念起远方的家乡。"
    },
    {
      "id": 20,
      "title": "古朗月行(节选)",
      "notes": [
        {
          "word": "呼作",
          "meaning": "称为"
        },
        {
          "word": "白玉盘",
          "meaning": "晶莹剔透的白盘子"
        },
        {
          "word": "疑",
          "meaning": "怀疑"
        },
        {
          "word": "瑶台",
          "meaning": "传说中神仙居住的地方"
        }
      ],
      "translation": "小时候不认识月亮，把它叫作白玉盘。又觉得它像是瑶台仙镜，飘浮在夜空的青云之上。"
    },
    {
      "id": 21,
      "title": "望庐山瀑布",
      "notes": [
        {
          "word": "香炉",
          "meaning": "指庐山的香炉峰"
        },
        {
          "word": "紫烟",
          "meaning": "日光透过云雾，远望如紫色烟云"
        },
        {
          "word": "遥看",
          "meaning": "从远处看"
        },
        {
          "word": "挂",
          "meaning": "悬挂"
        },
        {
          "word": "三千尺",
          "meaning": "夸张说法，形容瀑布极高"
        },
        {
          "word": "九天",
          "meaning": "天的最高处"
        }
      ],
      "translation": "香炉峰在阳光照射下升起紫色烟霞，从远处看瀑布如同白色绢绸悬挂山前。高崖上飞腾直落的瀑布仿佛有几千尺，让人怀疑是银河从天上倾泻到人间。"
    },
    {
      "id": 22,
      "title": "赠汪伦",
      "notes": [
        {
          "word": "将欲行",
          "meaning": "即将远行"
        },
        {
          "word": "踏歌",
          "meaning": "唐代民间流行的边走边唱的歌舞形式"
        },
        {
          "word": "桃花潭",
          "meaning": "位于今安徽泾县西南"
        },
        {
          "word": "深千尺",
          "meaning": "夸张写法，比喻友情深厚"
        },
        {
          "word": "不及",
          "meaning": "不如"
        }
      ],
      "translation": "李白乘船将要远行，忽然听见岸上传来踏歌之声。即使桃花潭的水深至千尺，也比不上汪伦送我的情意。"
    },
    {
      "id": 23,
      "title": "黄鹤楼送孟浩然之广陵",
      "notes": [
        {
          "word": "黄鹤楼",
          "meaning": "湖北武汉市武昌蛇山的著名古迹"
        },
        {
          "word": "之",
          "meaning": "往、到达"
        },
        {
          "word": "广陵",
          "meaning": "即扬州"
        },
        {
          "word": "故人",
          "meaning": "老朋友"
        },
        {
          "word": "烟花",
          "meaning": "形容柳絮如烟、鲜花似锦的春景"
        },
        {
          "word": "碧空尽",
          "meaning": "消失在碧蓝天际"
        }
      ],
      "translation": "老朋友在黄鹤楼与我告别，在春色明媚的三月前往扬州。孤独的船帆影像渐渐消失在碧蓝的天际，只能看到浩荡的长江水流向天边。"
    },
    {
      "id": 24,
      "title": "早发白帝城",
      "notes": [
        {
          "word": "白帝城",
          "meaning": "故址在今重庆市奉节县"
        },
        {
          "word": "朝",
          "meaning": "早晨"
        },
        {
          "word": "辞",
          "meaning": "告别"
        },
        {
          "word": "彩云间",
          "meaning": "白帝城地势高耸，仿佛在云间"
        },
        {
          "word": "江陵",
          "meaning": "今湖北荆州"
        },
        {
          "word": "猿啼",
          "meaning": "猿猴的叫声"
        },
        {
          "word": "万重山",
          "meaning": "层层叠叠的山"
        }
      ],
